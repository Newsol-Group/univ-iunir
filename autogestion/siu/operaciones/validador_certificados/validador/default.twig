{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% import "kernel/macro_recaptcha.twig" as recaptcha %}
    {{ recaptcha.script() }}
    
    <div class="alert alert-info">{{ "validador_certificados.descripcion" | trans | raw }}</div>

    {% if this.data.error.error_recaptcha %}
        <div id="recaptcha_error" class="alert alert-error">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            {{ this.data.error.error_recaptcha_msj }}
        </div>
    {% endif %}
	<form method="post" action="{{ this.data.url_validar }}" id="guarani_form_validar">
            <div id="control_group_documento" class="control-group{% if this.data.error.error_documento %} error{% endif %}">
                <label class="control-label" for="documento">{{ "validador_certificados.documento" | trans }}</label>
                <div class="controls">
                    <input id="documento" name="documento" type="text" value="{% if this.data.hubo_error %}{{ this.data.error.documento }}{% else %}{{ this.data.documento }}{% endif %}" {% if this.data.error.documento_disabled %} readonly {% elseif this.data.documento_disabled %} readonly {% endif %}/>
                    {% if this.data.error.error_documento %}
                        <br>
                        <span id="documento_error" class="help-inline">{{ this.data.error.error_documento_msj }}</span>
                    {% endif %}
                </div>
            </div>

            <div id="control_group_codigo_valid" class="control-group{% if this.data.error.error_codigo_validador %} error{% endif %}">
                <label class="control-label" for="codigo_valid">{{ "validador_certificados.codigo_validacion" | trans }}</label>
                <div class="controls">
                    <input id="codigo_valid" name="codigo_valid" type="text" value="{% if this.data.hubo_error %}{{ this.data.error.codigo_validador }}{% else %}{{ this.data.codigo_validador }}{% endif %}" maxlength="14"{% if this.data.error.codigo_validador_disabled %} readonly {% elseif this.data.codigo_validador_disabled %} readonly {% endif %}/>
                    {% if this.data.error.error_codigo_validador %}
                        <br>
                        <span id="codigo_valid_error" class="help-inline">{{ this.data.error.error_codigo_validador_msj }}</span>
                    {% endif %}
                </div>
            </div>
                
                        
            <div class="control-group">
                {{ recaptcha.widget() }}
            </div>
			
			{% if this.data.mensajes %}
				{% import "kernel/macro_notificaciones.twig" as notificaciones %}
				{{ notificaciones.render_notif(this.data.mensajes) }}
			{% endif %}
						
			
			<div class="control-group">
				<div class="controls">
					<input id="validar" name="validar" type="submit" value="{{ 'validador_certificados.validar' | trans }}" class="btn btn-info" />
				</div>
			</div>

	</form>
{% endblock %}