{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    {% autoescape false %}

        <div class="titulo_operacion">
            <h2 class="clearfix">
                <div class="pull-left">{{ "solicitar_certificacion.solicitud_titulo" | trans }}</div>
                <div class="pull-right">
                    <a href="{{ this.data.url_volver }}" class="btn" title="{{ 'volver' | trans }}"><i class="icon-backward"></i> {{ 'volver' | trans }}</a>
                </div>
            </h2>
        </div>

        {# Si hay mensaje lo muestro #}
        {% if this.data.mensaje is not empty %}
            <div class="alert {{ this.data.tipo_mensaje }}">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ this.data.mensaje | raw }}
            </div>
        {% endif %}

        <p class="alert alert-info mensaje strong">
            <strong>{{ 'requisitos.mensaje_doc_digital' | trans }}</strong>
        </p>

        {% if not this.data.error_cnx_rdi%}
            <p class="descr_requisito {% if this.data.error_extension %} alert alert-error mensaje strong {% endif %}">
                {{ 'requisitos.msj_extensiones' | trans }} <strong>{{ this.data.extensiones }}</strong>
            </p>
            <p class="descr_requisito {% if this.data.error_tamanio %} alert alert-error mensaje strong {% endif %}">
                {{ 'requisitos.msj_tamanio_max' | trans }} <strong>{{ this.data.tamanio_maximo }}</strong>
            </p>
        {% else %}
            <div class='alert alert-error mensaje_error'>
                {{ 'requisitos.msj_error_rdi' | trans | raw }}
            </div>
        {% endif %}

        {% if not this.data.error_cnx_rdi%}
            {% if this.data.error %}
                <div class='alert alert-error'>
                    {{ this.data.error }}
                </div>
            {% endif %}

            <div class='well clearfix'>
                <h3 class="requisito-header">{{ this.data.requisito.requisito_nombre }}</h3>
                {% if this.data.requisito.requisito_descripcion %}
                    <p class="descr_requisito">{{ this.data.requisito.requisito_descripcion }}</p>
                {% endif %}
                
                {# Si tiene requisito cargado y no es modificación #}
                {% if this.data.requisito.url_img_vista_previa_documento and (this.data.es_modificacion == 0) %}
                    
                    <div class="row-fluid">
                        <div class="span6 img-container">
                            {% set class_vista_previa = this.data.requisito.es_imagen ? 'img-rounded' : 'no-disponible' %}
                            <img src="{{ this.data.requisito.url_img_vista_previa_documento }}" class="{{ class_vista_previa }}" alt="{{ this.data.requisito.requisito_nombre }}">
                        </div>
                        <div class="span6 botonera">
                            <div class="botones">
                                <a href="{{ this.data.url_descargar }}" class="btn btn-info no-ajax" title="{{ 'requisitos.descargar' | trans }}">
                                    <i class="icon-download icon-white"></i> {{ 'requisitos.descargar' | trans }}
                                </a>
                                
                            {# Si Estado presentación digital es '-- Presentado --' no puede modificar #}
                            {% if this.data.requisito.estado_req_digital != this.data.estado_presentado %}
                                <a href="{{ this.data.url_modificar }}" class="btn btn-warning no-ajax" title="{{ 'requisitos.modificar' | trans }}">
                                    <i class="icon-pencil icon-white"></i> {{ 'requisitos.modificar' | trans }}
                                </a>
                            {% endif %}
                                
                            {# Si Estado presentación digital es '-- Presentado --' o '-- Vencido --' no puede eliminar #}
                            {% if this.data.requisito.estado_req_digital not in [this.data.estado_presentado, this.data.estado_vencido] %}
                                <form class="form-inline js-form-eliminar" method="POST" action="{{ this.data.url_eliminar }}">
                                    <input type="hidden" name="nro_solicitud" value="{{ this.data.certificado_tramitado.nro_solicitud }}">
                                    <input type="hidden" name="requisito" value="{{ this.data.requisito.requisito }}">
                                    <button type="button" class="btn btn-danger js-btn-eliminar" title="{{ 'requisitos.eliminar' | trans }}">
                                      <i class="icon-remove icon-white"></i> {{ 'requisitos.eliminar' | trans }}
                                    </button>
                                </form>
                            {% endif %}
                            </div>
                        </div>
                    </div>
                                    
                {# Si no tiene requisito cargado #}
                {% else %}
                    
                    {% set vencido = (this.data.requisito.estado_req_digital == this.data.estado_vencido)? 1 : 0 %}
                    <form class="form-inline" enctype="multipart/form-data" method="POST" action="{{ this.data.url_subir }}" autocomplete="off">
                        <div class="row-fluid">
                            <div class="span6">
                                <input type="hidden" name="MAX_FILE_SIZE" value="{{ this.data.tamanio_maximo_numero }}" />
                                <input type="hidden" name="nro_solicitud" value="{{ this.data.certificado_tramitado.nro_solicitud }}">
                                <input type="hidden" name="requisito" value="{{ this.data.requisito.requisito }}">
                                <input type="hidden" name="es_modificacion" value="{{ this.data.es_modificacion }}">
                                <input type="hidden" name="vencido" value="{{ vencido }}">
                                {# https://dev.to/ibn_abubakre/styling-file-inputs-like-a-boss-mhm #}
                                <div class="file-input">
                                  <input type="file" id="file" class="file" name="archivo" />
                                  <label for="file">
                                      {{ 'requisitos.btn_examinar' | trans }}
                                      <p class="file-name">{{ 'requisitos.no_selecciono_archivo' | trans }}</p>
                                  </label>
                                </div>
                            </div>
                            <div class="span6 text-right">
                                <button id="button_submit" type="submit" class="btn btn-success" title="{{ 'requisitos.subir' | trans }}">
                                    <i class="icon-upload icon-white"></i> {{ 'requisitos.subir' | trans }}
                                </button>
                            </div>
                        </div>
                    </form>
                {% endif %}
            </div>
        {% endif %}

    {% endautoescape %}
{% endblock %}