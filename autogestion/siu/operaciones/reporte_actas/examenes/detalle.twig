{% extends "kernel/pagelet.twig" %}
{% block contenido %}
<div class="titulo_operacion">
	<button class="btn btn-primary btn-small js-btn-back pull-left" data-url-back="{{this.data.url_volver}}"><i class="icon-chevron-left icon-white"></i></button>
	<h2 class="clearfix">
		<span class="pull-left">{{'header.menu.reporte_actas'|trans|capitalize}}</span>
		<div class="pull-right">
			<a class="btn" id="examenes-encabezado">{{'reporte_actas.ocultar_encabezado'|trans|capitalize}}</a>
			<a class="btn no-ajax" target="_blank" id="examenes-generar_pdf_detalle"><i class="g3w-icono-pdf"></i></a>
			<a class="btn no-ajax" target="_blank" id="examenes-generar_xls_detalle"><i class="g3w-icono-xls"></i></a>
		</div>
	</h2>
</div>
{% if this.data.encabezado %}
<table class="table table-striped table-bordered table-condensed" id="js-encabezados">
	<tr>
		<td style="font-weight: bold; width: 200px;">{{'reporte_actas.actividad'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.actividad_nombre}} ({{this.data.encabezado.actividad_codigo}})</td>
		<td style="font-weight: bold; width: 200px;">{{'reporte_actas.acta'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.nro_acta}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.anio_academico'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.anio_academico}}</td>
		<td style="font-weight: bold">{{'reporte_actas.folios'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.folios}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.turno_examen'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.turno_examen_nombre}}</td>
		<td style="font-weight: bold">{{'reporte_actas.mesa'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.mesa_examen_nombre}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.llamado'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.llamado_nombre}}</td>
		<td style="font-weight: bold">{{'reporte_actas.libro'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.libro}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.estado'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.estado_acta}}</td>
		<td style="font-weight: bold">{{'reporte_actas.codigo_verificacion'|trans|capitalize}}: </td>
		<td>{{this.data.encabezado.version}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.docentes'|trans|capitalize}}: </td>
		<td colspan="3">{{this.data.encabezado.docentes}}</td>
	</tr>
	<tr>
		<td style="font-weight: bold">{{'reporte_actas.observaciones'|trans|capitalize}}: </td>
		<td colspan="3">{{this.data.encabezado.observaciones}}</td>
	</tr>
</table>
{% endif %}
{% if this.data.alumnos %}
<table class="table table-striped table-bordered table-condensed">
	{% for folio, alumnos in this.data.alumnos %}
	<thead>
		<tr>
			<td colspan="6"><strong>{{'reporte_actas.folio'|trans|capitalize}}: {{folio}}</strong></td>
		</tr>
		<tr>
			<td class="cc-titulo-nivel-0">{{'reporte_actas.legajo'|trans|capitalize}}</td>
			<td class="cc-titulo-nivel-0">{{'reporte_actas.alumno'|trans|capitalize}}</td>
			<td class="cc-titulo-nivel-0">{{'reporte_actas.fecha'|trans|capitalize}}</td>
			<td class="cc-titulo-nivel-0">{{'reporte_actas.nota'|trans|capitalize}}</td>
			<td class="cc-titulo-nivel-0">{{'reporte_actas.resultado'|trans|capitalize}}</td>
		</tr>
	</thead>
		{% for alumno in alumnos %}
		<tr{% if alumno.rectificado == this.data.si or alumno.estado == this.data.acta_estado_invalidado %} class="tachado"{% endif %}>
			<td>{% if alumno.legajo %}{{alumno.legajo}}{% else %}{{'sin_definir'|trans|capitalize}}{% endif%}</td>
			<td>{{alumno.apellido}}, {{alumno.nombres}}</td>
			<td>{% if alumno.fecha %}{{alumno.fecha}}{% else %}{{'sin_definir'|trans|capitalize}}{% endif%}</td>
			<td>{% if alumno.nota_desc %}{{alumno.nota_desc}}{% else %}{{'sin_definir'|trans|capitalize}}{% endif%}</td>
			<td>{% if alumno.resultado_desc %}{{alumno.resultado_desc}}{% else %}{{ 'sin_definir' |trans|capitalize}}{% endif%}
				{% if alumno.rectificado == this.data.si %}
					<i class="icon-question-sign pull-right" title="{{'reporte_actas.alumno_rectificado'|trans|capitalize}}"></i>
				{% endif %}
				{% if alumno.estado == this.data.acta_estado_invalidado %}
					<i class="icon-question-sign pull-right" title="{{'reporte_actas.alumno_inhabilitado'|trans|capitalize}}"></i>
				{% endif %}
			</td>
		</tr>
		{% endfor %}
	{% endfor %}
</table>
{% else %}
<div class="alert">
	{{'reporte_actas.examenes.no_hay_datos'|trans|capitalize}}
</div>
{% endif %}
{% endblock %}