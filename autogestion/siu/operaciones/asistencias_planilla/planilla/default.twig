{% extends "kernel/pagelet.twig" %}
{% block contenido %}

	<!-- FILTRO -->
    {% set vista_form = this.get_vista_form() %}
    {{ vista_form.render_encabezado() | raw }}

    {{ vista_form.render_cuerpo() | raw }}
    <input type="hidden" id="flg_pdf" value="" />
    {{ vista_form.render_cierre() | raw }}

    <div class="row-fluid" style="margin-bottom: 20px;">
        <span class="pull-right">
			{{ vista_form.render_acciones() | raw }}
        </span>
        {% if this.data.planilla.clases %}
			<a id="boton_pdf" class="btn btn-small no-ajax" href="{{this.data.url.generar_pdf}}"><span class="g3w-icono-pdf"></span><span class="acchide"> {{'descargar_pdf'|trans|capitalize}}</span></a>
				{% endif %}
    </div>

    <!-- ENCABEZADO -->
	{% if this.data.planilla %}
		{% if this.data.planilla.cabecera %}
            {% if not this.data.planilla.clases %}
                <div class="alert alert-danger" role="alert">{{"asistencias.planilla.filtro_sin_resultados" | trans | capitalize }}</div>
            {% endif %}
            {% set cabecera = this.data.planilla.cabecera %}
			<table class="table table-condensed table-bordered" summary="Planilla de asistencias">
				<tr>
					<th scope="row" id="info_materia"><strong>{{"info_materia.materia" | trans | capitalize}}:</strong></td>
					<td headers="info_materia">({{cabecera.actividad_codigo}}) {{cabecera.actividad_nombre}}</td>
				</tr>
				<tr>
					<th scope="row" id="info_docente"><strong>{{"docente_comision" | trans | capitalize}}:</strong></th>
					<td headers="info_docente" colspan="3">{{cabecera.docentes}}</td>			
                </tr>
				<tr>
					<th scope="row" id="info_anio"><strong>{{"anio_academico" | trans | capitalize}}:</strong> </th>
					<td headers="info_anio">{{cabecera.anio_academico}}</td>
				</tr>			
				<tr>
					<th scope="row" id="info_periodo"><strong>{{"periodo_lectivo" | trans | capitalize}}:</strong></th>
					<td headers="info_periodo">{{cabecera.periodo_lectivo_nombre}}</td>
				</tr>	
				<tr>
					<th scope="row" id="info_catedra"><strong>{{"catedra" | trans | capitalize}}:</strong></th>
					<td headers="info_catedra">
                        {% if (cabecera.catedra_nombre) %}
							{{cabecera.catedra_nombre}}
                        {% else %}
							{{'asistencias.planilla.sin_informacion'|trans |capitalize}}
                        {% endif %}
                    </td>	
				</tr>	
				<tr>
					<th scope="row" id="info_comision"><strong>{{"comision" | trans | capitalize}}:</strong></th>
					<td headers="info_comision">{{cabecera.comision_nombre}}</td>
				</tr>	
				<tr>
					<th scope="row" id="info_subcomision"><strong>{{"subcomision" | trans | capitalize}}:</strong></th>
					<td headers="info_subcomision">                                           
                        {% if (cabecera.subcomision) %}
                            {{cabecera.subcomision_nombre}}
                        {% else %}
                            {{'asistencias.planilla.sin_informacion'|trans |capitalize}}
                        {% endif %}
                    </td>
				</tr>
				<tr>
					<th scope="row" id="info_aula"><strong>{{"dia, hora, edificio y aula" | trans | capitalize}}:</strong></th>
					<td headers="info_aula" colspan="3">
                        {% if (cabecera.horario_aulas) %}
                            {{cabecera.horario_aulas}}
                        {% else %}
                            {{'asistencias.planilla.sin_informacion'|trans |capitalize}}
                        {% endif %}                                            
                    </td>
				</tr>
			</table>
        {% endif %}
        <!-- CUERPO --> 
        <table class="table table-striped table-bordered table-condensed">
			<thead>
				<tr>
					<th scope="col" id="nro">{{"número" | trans | capitalize}}</th>
					<th scope="col" id="legajo">{{"legajo" | trans | capitalize}}</th>
					<th scope="col" id="apellido_y_nombre">{{"apellido_y_nombre" | trans | capitalize}}</th>
					<th scope="col" id="inasistencias">{{"inasistencias acumuladas" | trans | capitalize}}</th>                                        
					{% for i, clase in this.data.planilla.clases %}
					<th scope="col" id="fecha~i">{{clase}}</th>
					{% endfor %}
				</tr>
			</thead>
			<tbody>
				{% for orden, alumno in this.data.planilla.alumnos %}
					<tr>
						<td headers="nro">{{orden+1}}</td>
						<td headers="legajo">{{alumno.alumno_legajo|raw}}</td>
						<td headers="apellido_y_nombre">{{alumno.alumno_nombre_elegido|raw}}</td>
						<td headers="inasistencias">{{alumno.total_inasistencias|raw}}</td>
						{% for i, clase in this.data.planilla.clases %}
							<td>&nbsp;</td>
						{% endfor %}
					</tr>
				{% endfor %}
			</tbody>	
        </table>
	{% else %}
		<div role="alert" class="alert">
			{{"asistencias.planilla.no_hay_datos"|trans|capitalize}}
		</div>
	{% endif %}
{% endblock %}