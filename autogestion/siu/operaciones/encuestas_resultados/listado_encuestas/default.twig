{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% if this.data.encuestas_resultados %}

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="centrado">{{ 'encuestas_resultados.relevamiento' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.titulo' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.materia' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.comision' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.perido_lectivo' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.encuestados' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.respondidas' | trans }}</th>
                    <th class="centrado"></th>
                </tr>
            </thead>

            <tbody>
                
                {% for encuesta_resultado in this.data.encuestas_resultados %}
                    
                    <tr>
                        <td>{{ encuesta_resultado.habilitacion_titulo }}</td>
                        <td>{{ encuesta_resultado.encuesta_titulo }}</td>
                        <td>{{ encuesta_resultado.actividad_nombre }}</td>
                        <td style="text-align: center">{{ encuesta_resultado.comision_nombre }}</td>
                        <td>{{ encuesta_resultado.periodo_lectivo_nombre | capitalize }}</td>
                        <td style="text-align: center">{{ encuesta_resultado.cant_encuestados}}</td>
                        <td style="text-align: center">{{ encuesta_resultado.cant_respondidas}}</td>
                        <td class="centrado">
                            
                            {%if encuesta_resultado.cant_encuestados > 0 %}
                                
                                <a class="btn btn-small btn-primary" 
                                   href="{{this.data.url_ver_bloques~'?encuesta='
                                           ~encuesta_resultado.kolla_id_encuesta_hash~'&formulario='
                                           ~encuesta_resultado.formulario_hash~'&habilitacion='
                                           ~encuesta_resultado.kolla_id_habilitacion_hash~'&unidad_gestion='
                                           ~encuesta_resultado.kolla_unidad_gestion~'&elemento='
                                           ~encuesta_resultado.elemento_externo_hash
                                         }}"
                                   type="button" data-encuesta="{{ encuesta_resultado.encuesta }}">
                                    {{ 'encuestas_resultados.ver' | trans }}
                                </a>
                                
                            {%endif%}
                            
                        </td>
                    </tr>
                    
                {% endfor %}
                
            </tbody>
        </table>
        <div id="codigo_recuperacion" class="modal hide fade"></div>
        <div id="encuesta_respondida_kolla" class="modal hide fade"></div>

    {% else %}

        <div class="alert">{{ 'encuestas_resultados.sin_resultados' | trans }}</div>

    {% endif %}

{% endblock %}

