{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    <div class="titulo_operacion">
        <h2 class="clearfix">
            <span class="pull-left">
                {{"header.menu.seguimiento_tesis" | trans }}
            </span>
        </h2>
    </div>


	{% if this.data.tesis_solicitadas is empty %}

        <div id="alert-no-hay-preguntas" class="alert">{{ this.data.msg_sin_dato }}</div>

    {% else %}

		{# Creo expandible para mostrar tesis con estado actual y fecha #}
		{% for  titulo  in this.data.tesis_solicitadas %}
			<div class="accordion-group">
				<div class="encabezado-form clearfix  accordion-heading">
					<div class="accordion-toggle titulo" data-toggle="collapse" data-target="#collapse{{ titulo.tesis}}">

						<div class="nombre_certificado">{{ titulo.titulo }}</div>
						<div class="estado_actual">{{'header.menu.estado_actual' | trans }} {{ titulo.datos.estado_actual_desc }}</div>
						<div class="js-minimizar" ><i class="icon-chevron-down icon-white" ></i></div>
						<div style="clear: both;"></div>
					</div>
				</div>





				<div id="collapse{{ titulo.tesis}}" class="accordion-body collapse">
					<div class="accordion-inner">

						{% if titulo.estados is empty %}

							<div id="alert-no-hay-preguntas" class="alert">{{"seguimiento_tesis.estados_vacio" | trans }}</div>

						{% else %}

							{# Creo pop up de datos extra de la tesis #}

							<a href="#" data-toggle="modal" data-target=".bd-example-modal-lg{{ titulo.tesis}}">{{"seguimiento_tesis.link_datos" | trans }}</a>

							<div class="modal fade bd-example-modal-lg{{ titulo.tesis}}" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">

								<div class="modal-header">
									<div class="modal-title" style="font-weight: bolder; font-size:18px;"> {{"header.menu.seguimiento_tesis" | trans }}</div> 
								</div>
								
								<div class="modal-dialog modal-lg">
									
									<div class="modal-body">

										<p>
										<div class="modal-title" style="text-decoration: underline; font-size: 18px;">{{ titulo.titulo }}</div>
										</p>
										<p> {{'seguimiento_tesis.actividad' | trans }} {{ titulo.datos.actividad_nombre }}
										</p>
										<p> {{'seguimiento_tesis.estado_actual' | trans }}{{ titulo.datos.estado_actual_desc }}
										</p>
										<p>  {{'seguimiento_tesis.fecha_ultimo_cambio' | trans }}{{ titulo.datos.fecha_ultimo_cambio }}
										</p>
										<p>
											{{'seguimiento_tesis.tutores' | trans }}{{ titulo.datos.tutores }}
										</p>
										<p>
											{{'seguimiento_tesis.evaluadores' | trans }}{{ titulo.datos.evaluadores }}
										</p>
										<p>
											{{'seguimiento_tesis.fecha_presentacion' | trans }}{{ titulo.datos.fecha_aprobacion }}
										</p>
										<p>
											{{'seguimiento_tesis.fecha_vencimiento' | trans }}{{ titulo.datos.fecha_vencimiento }}
										</p>
										<p>
											{{'seguimiento_tesis.fecha_defensa' | trans }}{{ titulo.datos.fecha_defensa }}
										</p>
										<p>
											{{'seguimiento_tesis.nro_expediente' | trans }}{{ titulo.datos.nro_expediente }}
										</p>

									</div>

									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
									</div>
								</div>
							</div>

										
							<table class="table table-bordered table-condensed">
								<thead>
									<tr>
										<th> {{ 'seguimiento_tesis.fecha' | trans }}</th>
										<th> {{ 'seguimiento_tesis.accion' | trans }}</th>
										<th> {{ 'seguimiento_tesis.estado' | trans }}</th>
									</tr>
								</thead>

								<tbody>

									{% for dato in  titulo.estados %}

										<tr>
											<td>{{ dato.fecha_cambio }}</td>
											<td>{{ dato.accion_nombre }}</td>
											<td>{{ dato.estado_nuevo_desc }}</td>
										</tr>

									{% endfor %}
								</tbody>

							</table>

						{% endif %}

					</div>
				</div>
			</div>


		{% endfor %}

	{% endif %}	
{% endblock %}