{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<div id="cuadroBuscarLocalidad">
		<form id="localidades" action="{{this.data.form.getAction}}" method="post">
		<div class="container">
			<div class="row">
				<div class="span12">
					<h2>Localidades</h2>		
				</div>
			</div>		
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.pais.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.pais.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.provincia.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.provincia.renderViewHelper|raw}}
						</div>
						<p id="error_busqueda_provincia">{{"error_busqueda_provincia"|trans|capitalize}}</p>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.localidad.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.localidad.renderViewHelper|raw}}
						</div>
						<p id="error_busqueda_localidad">{{"error_busqueda_localidad"|trans|capitalize}}</p>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group pull-right">
						<input id="buscar" type="button" value="Buscar" />
						<img src="img/ajax-loader.gif" id="ajax-loader" />
					</div>
				</div>
			</div>
		

			<div class="row" id="tablaResultados">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							<label from="cps">{{"busqueda_cp"|trans|capitalize}}</label>
						</div>
						<div class="controls">
							<select id="cps" size="5"></select>
						</div>
						<p id="error_busqueda_cp">{{"error_busqueda_cp"|trans|capitalize}}</p>
					</div>
				</div>
			</div>
				
			<div class="row" id="tablaNoResultados" style="display: none;">
				<div class="span12">
					<div class="control-group">
						{{"busqueda_sin_resultados"|trans|capitalize}}
					</div>
				</div>
			</div>
			
			<div class="row">
				<div class="span6">
					<div class="control-group">
						<input id="cancelar" type="button" value="Cancelar" />
					</div>
				</div>
				<div class="span6">
					<div class="control-group pull-right">
						<input id="agregar" type="button" value="Agregar" />
					</div>
				</div>
			</div>
		</div>
		</form>
	</div>
	<div class="titulo_operacion">
		<h2 class="clearfix"><span class="pull-left">{{"header.menu.censo_docente"|trans|capitalize}}</span>
			<button id="guardar" type="button" name="guardar" class="btn btn-info pull-right">{{"censo.form.guardar"|trans|capitalize}}</button>
		</h2>		
	</div>
	<p id="mensaje"></p>
	<form id="principales" class="form-horizontal" action="{{ this.data.url_guardar }}" method="post">
	{% import "kernel/macro_csrf.twig" as input_csrf %}
	{{ input_csrf.mostrar(this.generar_csrf) }}

	{{this.data.form.form_id.renderViewHelper|raw}}
		<div class="container">
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.CENS_E_MAIL.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.CENS_E_MAIL.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							<label>Dirección</label>
						</div>
						<div class="controls inline">
							<div class="control-group">
								<div class="control-label">
									{{this.data.form.CENS_CALLE_PER_LECT.renderLabel|raw}}
								</div>
								<div class="controls">
									{{this.data.form.CENS_CALLE_PER_LECT.renderViewHelper|raw}}
								</div>
							</div>
							<div class="control-group">
								<div class="control-label">
									{{this.data.form.CENS_NUMERO_PER_LECT.renderLabel|raw}}
								</div>
								<div class="controls">
									{{this.data.form.CENS_NUMERO_PER_LECT.renderViewHelper|raw}}
								</div>
							</div>
							<div class="control-group">
								<div class="control-label">
									{{this.data.form.CENS_PISO_PER_LECT.renderLabel|raw}}
								</div>
								<div class="controls">
									{{this.data.form.CENS_PISO_PER_LECT.renderViewHelper|raw}}
								</div>
							</div>
							<div class="control-group">
								<div class="control-label">
									{{this.data.form.CENS_DPTO_PER_LECT.renderLabel|raw}}
								</div>
								<div class="controls">
									{{this.data.form.CENS_DPTO_PER_LECT.renderViewHelper|raw}}
								</div>
							</div>
							<div class="control-group">
								<div class="control-label">
									{{this.data.form.CENS_UNIDAD_PER_LECT.renderLabel|raw}}
								</div>
								<div class="controls">
									{{this.data.form.CENS_UNIDAD_PER_LECT.renderViewHelper|raw}}
								</div>
							</div>
						</div>
					</div>					
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.CENS_LOC_PER_LECT_TEXTO.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.CENS_LOC_PER_LECT_TEXTO.renderViewHelper|raw}}
							{{this.data.form.CENS_LOC_PER_LECT.renderViewHelper|raw}}
							<input id="btnLocPersonal" name="btnLocPersonal" value="Buscar Localidad" type="button" class="btn" />
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.CENS_CP_PER_LECT.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.CENS_CP_PER_LECT.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.CENS_TE_PER_LECT.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.CENS_TE_PER_LECT.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.AUX1_CELULAR_NUMERO.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.AUX1_CELULAR_NUMERO.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="span12">
					<div class="control-group">
						<div class="control-label">
							{{this.data.form.AUX1_CELULAR_COMPANIA.renderLabel|raw}}
						</div>
						<div class="controls">
							{{this.data.form.AUX1_CELULAR_COMPANIA.renderViewHelper|raw}}
						</div>
					</div>
				</div>
			</div>
		</div>
	</form>
{% endblock %}