{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% import "kernel/macro_recaptcha.twig" as recaptcha %} 
    {{ recaptcha.script() }} 

    {% set form = this.get_form() %}
    {% autoescape false %}

        <div class="alert alert-warning strong">
            {{ 'alta_uc.msj_advertencia_alta' | trans | raw }}
        </div>

        {% if this.estado in [this.data.inicial, this.data.form_error_validacion, this.data.error_recaptcha, this.data.form_error_csrf] %}

            {{ form.encabezado }}
            {% if this.data.mensajes %}
                <div class='strong'>
                    {% import "kernel/macro_notificaciones.twig" as notificaciones %}
                    {{ notificaciones.render_notif(this.data.mensajes) }}
                </div>
            {% endif %}

            
            {% import "kernel/macro_csrf.twig" as input_csrf %}
            {{ input_csrf.mostrar(this.data.csrf) }}
                        
            <div class='well clearfix'>
                <h3 class='toggle-header' onclick="toggle('datos_personales');">{{ 'alta_uc.datos_personales' | trans }}</h3>
                <div id='datos_personales' class='toggle-div'>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('sexo', 'span6') }}
                    </div>

                    <div class='clearfix cg-margen' data-toggle="tooltip" data-placement="top" data-original-title="{{'alta_uc.mensaje_identidad_genero'|trans}}">
                        {{ form.control_group('identidad_genero', 'span6') }}
                        {{ form.control_group('identidad_genero_otro', 'span4')  }}
                    </div> 
                    <p id="ayuda_genero" class='control-group span6'><i class='icon-question-sign'></i> {{'alta_uc.ayuda_identidad_genero'|trans({'%link%': this.data.url_identidad_genero})|raw}}</p>

                    <div class='clearfix cg-margen'>
                        {{ form.control_group('nacionalidad', 'span6') }}
                        {{ form.control_group('pais_documento', 'span6') }}
                    </div>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('tipo_documento', 'span6') }}
                        {{ form.control_group('nro_documento', 'span6') }}
                    </div>
                    
                    <div id="js_nro_documento" class="alert alert-info"><!-- Se completa con JS --></div>
                    
                    {% if this.data.mat_validacion_renaper == 'S' %}
                    <div class='clearfix cg-margen' id="js_renaper">                    
                        <div id="js_ayuda_numero_tramite" class="alert alert-info"><!-- Se completa con JS --></div>
                        <p>
                            {{'alta_uc.ayuda_numero_tramite'|trans|raw}}
                            <a href="#" id="ayuda_numero_tramite" class='control-group' data-toggle="popover" data-placement="top" data-img="{{ this.data.url_img_nro_tramite_dni }}">
                                <i class='icon-question-sign'></i>
                            </a>                                                         
                        </p>
                        {{ form.control_group('nro_tramite_dni', 'span6 divNroTramite') }}
                        <input type="button" id="validar" name="validar" value="{{'alta_uc.ws_renaper.validar'|trans|capitalize}}" class="btn btn-info" onclick="validar_nro_tramite_dni()"/>
                        <div id="js_nro_tramite_dni" class="alert alert-info"><!-- Se completa con JS --></div>                                    
                    </div>
                    
                    <!-- Aca coloco los inputs que estaran ocultos -->
                    <div class='clearfix cg-margen'>
                            {{ form.control_group('periodo_lectivo_calle', 'span6') }}
                            {{ form.control_group('periodo_lectivo_numero', 'span6') }}
                            {{ form.control_group('periodo_lectivo_piso', 'span6') }}
                            {{ form.control_group('periodo_lectivo_departamento', 'span6') }}
                            {{ form.control_group('periodo_lectivo_codigo_postal', 'span6') }}
                            {{ form.control_group('periodo_lectivo_barrio', 'span6') }}
                            {{ form.control_group('numero_cuil', 'span6') }}
                            {{ form.control_group('validado_con_renaper', 'span6') }}
                    </div>
                    {% endif %}
                    <div class='clearfix cg-margen' id="apellido_nombre">
                            {{ form.control_group('apellido', 'span6 div_apellido') }}
                            {{ form.control_group('nombres', 'span6 div_nombre') }}
                    </div>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('nombres_elegido', 'span6') }}
                        <p id="leyenda">{{'leyenda_nombre_elegido'|trans}}<p>
                    </div>
                </div>
            </div>

            <div class='well clearfix'>
                <h3 class='toggle-header' onclick="toggle('datos_nacimiento');">{{ 'alta_uc.datos_nacimiento' | trans }}</h3>
                <div id='datos_nacimiento' class='toggle-div'>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('fecha_nacimiento') }}
                        <div class='clearfix cg-margen'>
                            {{ form.control_group_localidad('localidad', 'localidad_descr', 'pais') }}
                            <div id='localidad_help' class='clearfix inline-help italic cg-margen'>
                                {{'datos_censales.ayuda_lista_localidades'|trans}}
                            </div>
                            <input id="btnLimpiarLoc" value="{{'datos_censales.limpiar'|trans}}" type="button" class="btn btn-inverse" />
                            <input id="btnSelectorLoc" name="btnSelectorLocalidad" value="{{'datos_censales.busqueda_avanzada'|trans}}" type="button" class="btn btn-inverse" />
                        </div>
                    </div>
                </div>
            </div>

            <div class='well clearfix'>
                <h3 class='toggle-header' onclick="toggle('datos_usuario');">{{ 'alta_uc.datos_usuario' | trans }}</h3>
                <div id='datos_usuario' class='toggle-div'>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('email', 'span6') }}
                        {{ form.control_group('email_rep', 'span6') }}
                    </div>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('usuario', 'span6') }}
                    </div>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('password', 'span6') }}
                        {{ form.control_group('rpassword', 'span6') }}
                    </div>

                    {% if this.data.aclaracion_clave %}
                        <div class='clearfix inline-help strong'>
                            {{ this.data.aclaracion_clave }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class='well clearfix'>
                <h3 class='toggle-header' onclick="toggle('propuesta');">{{ 'alta_uc.propuesta' | trans }}</h3>
                <div id='propuesta' class='toggle-div'>
                    <div class='clearfix cg-margen'>
                        {{ form.control_group('propuesta') }}
                    </div>
                </div>
            </div>

            {% if this.data.usar_captcha %}
                <div class='pull-right'>
                    <div class="control-group">
                        {{ recaptcha.widget() }} 
                    </div>
                </div>
                <div class='clearfix'></div>
            {% endif %}

            <div class='botonera-inferior'>
                <div class='pull-right'>
                    <input type="button" name="volver" value="{{'volver'|trans|capitalize}}" class="btn btn-info" onclick="window.location.href = '{{this.data.url_volver}}'" />
                    {{ form.submit_button('continuar', 'alta_uc.aceptar')}}					
                </div>
            </div>

        </div>
    </form>

{% else %}
    {% import "kernel/macro_notificaciones.twig" as notificaciones %}
    {{ notificaciones.render_notif(this.data.mensajes) }}
    <div class='pull-right'>
        <input type="button" name="volver" value="{{'volver'|trans|capitalize}}" class="btn btn-info" onclick="window.location.href = '{{this.data.url_volver}}'" />
    </div>
{% endif %}

{% endautoescape %}
{% endblock %}
