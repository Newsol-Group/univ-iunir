{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    <div class="titulo_operacion">
        <h2 class="clearfix">
            <div class="pull-left">{{ "header.menu.requisitos_becas" |trans }}</div>
        </h2>
    </div>
                            
    <ul class="breadcrumb">
        <li class="active">{{ 'header.menu.tramites' | trans }} <span class="divider">/</span></li>
        <li class="active">{{ 'header.menu.convocatorias_becas' | trans }} <span class="divider">/</span></li>
        <li class="active">{{ this.data.info_habilitacion.convocatoria.nombre ?? this.data.info_habilitacion.titulo }}</li>
    </ul>
    
    {# Si hay mensaje lo muestro #}
    {% if this.data.mensaje is not empty %}
    <div class="alert {{ this.data.tipo_mensaje }}">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        {{ this.data.mensaje | raw }}
    </div>
    {% endif %}
    
    {# Si no hay requisitos #}
    {% if this.data.requisitos is empty %}
        <div class="alert">{{ 'requisitos_becas.sin_requisitos' | trans }}</div>
    {# Si hay requisitos #}
    {% else %}
        
        {# Si se trata de una reapertura #}
        {% if this.data.es_reapertura %}
            <div class="alert alert-info">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ 'requisitos_becas.leyenda_reapertura' | trans | raw }}
            </div>
        {% endif %}
    
        <div class="alert alert-info">
          <button type="button" class="close" data-dismiss="alert">&times;</button>
          {{ 'requisitos_becas.leyenda_documentos_obligatorios' | trans | raw }}
        </div>
        
        <table class="table table-striped table-bordered table-hover">
              <thead>
                <tr>
                  <th>{{ 'requisitos_becas.requisito_nombre' | trans }}</th>
                  <th>{{ 'requisitos_becas.requisito_estado' | trans }}</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {# Recorro los requisitos #}
                {% for requisito in this.data.requisitos %}
                <tr>
                  <td>
                      {% if requisito.obligatorio == this.data.si %}
                        <strong>{{ requisito.nombre }} (*)</strong>
                      {% else %}
                        {{ requisito.nombre }}
                      {% endif %}
                  </td>
                 
                    {% if requisito.estado == this.data.rechazado %}
                       {% set label_estado = 'label-important' %}
                    {% elseif requisito.estado == this.data.no_posee %}
                       {% set label_estado = 'label-info' %}
                    {% elseif requisito.estado == this.data.presentado %}
                       {% set label_estado = 'label-success' %}
                    {% elseif requisito.estado == this.data.no_presentado %}
                       {% set label_estado = 'label-warning' %}
                    {% endif %}
                  <td><span class="label {{ label_estado }}">{{ requisito.estado }}</span></td>
                  <td>
                      <div class="row-fluid">
                          
                        <div class="span6">
                            
                            {# Si es reapertura y no esta rechazado entonces deshabilito "No poseo" #}
                            {% set checkbox_no_poseo_disabled = this.data.es_reapertura and (requisito.rechazado == this.data.no) %}
                            {% set checkbox_no_poseo_checked = requisito.no_posee == 1 %}
                            
                            <label class="checkbox inline">
                              <input type="checkbox" class="js-no-poseo" data-requisito="{{ requisito.requisito }}" {% if checkbox_no_poseo_checked %}checked{% endif %} {% if checkbox_no_poseo_disabled %}disabled{% endif %}> {{ 'requisitos_becas.requisito_no_poseo' | trans }}
                            </label>
                                
                            {# Si "No poseo" esta habilitado le permito "Guardar" #}
                            {% if not checkbox_no_poseo_disabled %}
                            <form id="js-form-guardar-{{ requisito.requisito }}" class="form-inline js-form-guardar" method="POST" action="{{ this.data.url_guardar_noposeo }}">
                                <input type="hidden" name="habilitacion" value="{{ this.data.habilitacion }}">
                                <input type="hidden" name="requisito" value="{{ requisito.requisito }}">
                                <input id="js-input-no-posee-original-{{ requisito.requisito }}" type="hidden" name="no_posee_original" value="{{ requisito.no_posee }}">
                                <input id="js-input-no-posee-actual-{{ requisito.requisito }}" type="hidden" name="no_posee_actual" value="{{ requisito.no_posee }}">
                                <button id="js-btn-guardar-{{ requisito.requisito }}" type="button" class="btn btn-info btn-mini js-btn-guardar" data-toggle="tooltip" data-html="true" title="{{ 'requisitos_becas.btn_guardar_tooltip' | trans }}" disabled>
                                    <i class="icon-check icon-white"></i> {{ 'requisitos_becas.btn_guardar' | trans }}
                                </button>
                            </form>
                            {% endif %}
                        </div>
                            
                        <div class="span6">
                          {# Si es reapertura y no esta rechazado ni presentado, o "No posee" requisito entonces deshabilito el botón "Documento digital" #}
                          {% set btn_editar_disabled = (this.data.es_reapertura and (requisito.rechazado == this.data.no) and (requisito.presentado == this.data.no)) or (requisito.no_posee == 1) %}
                          {% if not btn_editar_disabled %}
                              {% set btn_editar_href = (this.data.url_editar ~ "/" ~ this.data.habilitacion ~ "/" ~ requisito.requisito) %}
                              <a 
                                  id="js-btn-editar-{{ requisito.requisito }}" 
                                  class="btn btn-primary js-editar no-ajax"
                                  title="{{ 'requisitos.doc_digital' | trans }}"
                                  href="{{ btn_editar_href }}" 
                              >
                                  <i class="icon-edit icon-white"></i> {{ 'requisitos.doc_digital' | trans }}
                              </a>
                          {% endif %}
                        </div>
                        
                      </div>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
        </table>
              
        <div class="row-fluid">
            <div class="span12">
                <a 
                    href="{{ this.data.btn_continuar_disabled ? '#' : this.data.url_continuar }}" 
                    class="btn btn-large btn-primary pull-right {% if this.data.btn_continuar_disabled %}disabled{% endif %}"
                    data-toggle="tooltip"
                    data-html="true"
                    title="{{ (this.data.btn_continuar_disabled ? 'requisitos_becas.btn_continuar_tooltip_disabled' : 'requisitos_becas.btn_continuar_tooltip_enabled') | trans }}"
                >
                    {{ 'requisitos_becas.btn_continuar' | trans }}
                </a>
            </div>
        </div>
    {% endif %}
    
{% endblock %}