{% extends "kernel/pagelet.twig" %}
{% block contenido %}<div class="controls">
			</div>
	{% if this.data.clase_detalle %}
            <form class='form-renglones' action='{{ this.data.url_guardar }}' method='post'>
				{% for clase in this.data.clase_detalle %}
		<input type="hidden" name="clase" value="{{ this.data.clase_id }}">
			<div id="temas_planificados" >
			<label>{{"temas_planificados"|trans|capitalize}}</label>
			<div class="controls">
				<textarea id="temas_planificados_text" name="tema_planificado" >{{clase.tema_planificado}}</textarea>
			</div>
                        
			<div class="cuadro_boton">
				<input id='js-copiar_temas' value='{{"copiar a temas dictados"|trans|capitalize}}' class="btn btn-info btn-small" />
			</div>
                        
                        </div>
                        <div id="temas_dictados" >
			<label>{{"temas_dictados"|trans|capitalize}}</label>
			<div class="controls">
				<textarea id="temas_dictados_text" name="tema_dictado">{{clase.tema_dictado}}</textarea>
			</div>
                        </div>
			<div class="cuadro_boton">
				<input id='js-guardar_temas' type='submit' value='{{"guardar"|trans|capitalize}}' class="btn btn-info btn-small" />
			</div>
                        {% endfor %}
		</form>
	{% else %}
		<div class="alert">{{"no_hay_renglones"|trans|capitalize}}</div>
	{% endif %}

{% endblock %}