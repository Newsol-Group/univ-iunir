{% extends "kernel/pagelet.twig" %}
{% import 'kernel/macro_helpers.twig' as helper %}
{% import _self as current_file_macros %}

{% block contenido %}

	{% if this.data.filtro_ok %}
		{% for actividad in this.data.actividades %}
			<h4 class='actividad-tit'>{{ actividad.nombre }}</h4>
			<table class="table table-striped table-bordered table-condensed">
				<thead>
				<th>{{ 'admin_derechos_mesa.mesa'|trans|capitalize }}</th>
				<th>{{ 'admin_derechos_mesa.fecha'|trans|capitalize }}</th>
				<th>{{ 'admin_derechos_mesa.llamado_mesa'|trans|capitalize }}</th>
				<th>{{ 'admin_derechos_mesa.ubicacion'|trans|capitalize }}</th>
				<th>{{ 'admin_derechos_mesa.docentes'|trans|capitalize }}</th>
				</thead>
				<tbody>

				{% for mesa in actividad.mesas %}
					<tr {{ this.data_link(mesa.LINK) | raw }}>
						<td>{{ this.a(mesa.LINK, mesa.mesa_examen_nombre) | raw }}
						<td>{{ mesa.fecha_formato_visual }}</td>
						<td>{{ mesa.llamado_nombre }}</td>
						<td>{{ mesa.ubicacion_nombre }}</td>
						<td class='btn-container'>
							{% if(this.tiene_acceso_link(mesa.LINK_DOC)) %}
								<button class="btn btn-small js-info-docentes" data-url="{{ mesa.LINK_DOC }}">
									{{ 'admin_derechos_mesa.ver_docentes'|trans|capitalize }}
								</button>
							{% else %}
								<button class="btn btn-small disabled">{{ 'admin_derechos_mesa.ver_docentes'|trans|capitalize }}</button>
							{% endif %}

						</td>
					</tr>

				{% endfor %}
				</tbody>
			</table>

			{{ current_file_macros.template_docentes() }}
	{% else %}
		<div class="alert">{{ 'no_hay_mesas'|trans|capitalize }}</div>
	{% endfor %}

	{% else %}
		<div class="alert">{{ 'eof_cuadro_sinfiltro'|trans|capitalize }}</div>


	{% endif %}
{% endblock %}

{# Se usa para crear las filas del popup de docentes#}
{% macro template_docentes() %}
	<div id='template_docente' style="display: none; background-color: #aaa; padding: 20px;">
		<div class="ficha-docente clearfix">
			<img style="margin-right: 5px" src='' width='35' height="35" title='' class="pull-left"/>

			<div class="pull-left">
				<span class="nombre"></span>
				<span class="identificacion"></span>
			</div>
			<div class="pull-right">
				<span class="responsabilidad"></span>
			</div>
		</div>
	</div>
{% endmacro %}