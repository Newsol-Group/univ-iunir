{% extends "kernel/pagelet_polite.twig" %}

{% block contenido %}

    {% if this.estado == this.data.estado_inicial %}

		{% include 'info_curso/estado_inicial.twig' with {
            'inscripciones': this.data.inscripciones,
            'mensajes': this.data.mensajes,
            'si':	this.data.si,
            'no':	this.data.no,
            'inscripcion_pendiente':	this.data.inscripcion_pendiente,
            'inscripcion_aceptada':	    this.data.inscripcion_aceptada,
            'csrf':		this.data.csrf,
            'catalogo_id':	this.data.catalogo_id,
        } only %}

    {% elseif this.estado == this.data.estado_curso_seleccionado %}
		
        <h3>{{this.data.curso_nombre}} ({{this.data.curso_codigo}})</h3>
        <h4>{{this.data.responsables_academicas}}</h4>
		
        {% if this.data.mensajes %}
            {% import "kernel/macro_notificaciones.twig" as notificaciones %}
            {{ notificaciones.render_notif(this.data.mensajes) }}
        {% endif %}

        {% if this.data.comisiones is empty %}
            <div class='alert alert-warning'>{{ 'inscripcion_cursos.no_hay_comisiones' | trans }}</div>
        {% else %}
            
                <div id="dias-semana">

                            <div class="filtros-label">{{ 'inscripcion_a_cursadas.dias' | trans }}: </div>
                            <div class="btn-toolbar opciones">
                                <div class="btn-group" data-toggle="buttons-checkbox">
                                    {% for dias in this.data.dias_semana %}
                                        <button type="button" class="btn btn-mini js-dia" data-dia="{{ dias.valor }}">{{ dias.descr[:3] }}</button>
                                    {% endfor %}
                                </div>
                            </div>
                            <div style="clear: both;"></div>
                            
                </div>
                                
                <div id="ubicaciones">

                            <div class="filtros-label">{{ 'inscripcion_a_cursadas.ubicacion' | trans }}: </div>
                            <div class="opciones">
                                <select class="input-small" id="js-ubicaciones">
                                    <option value="0">{{ 'inscripcion_a_cursadas.ubicacion.todas' | trans }}</option>
                                    {% for ubicacion in this.data.ubicaciones %}
                                        <option value="{{ ubicacion.valor }}">{{ ubicacion.descr }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div style="clear: both;"></div>

                </div>
            <ul id='comisiones' class="unstyled">                     
                                
            {% for ubicacion, sedes_comisiones in this.data.sedes_comisiones %}

                    <div class="accordion" id="accordion{{ ubicacion }}">
                    <div class="accordion-group">
                        <div class="accordion-heading">
                            <a class="accordion-toggle " data-toggle="collapse" data-parent="#accordion{{ ubicacion }}" data-target="#collapse{{ ubicacion }}">
                                {{ sedes_comisiones.ubicacion_nombre }} 
                            </a>
                        </div>
                        <div id="collapse{{ ubicacion }}" class="accordion-body js-accordion in">

                            <div class="accordion-inner">
                                
                                {% for sede_comision in sedes_comisiones.comisiones  %}
                                    
                                    {% set filtros_dia_css = '' %}
                                        {% if sede_comision.dias_semana is not empty %}
                                            {% set dias_semana = sede_comision.dias_semana|split(',') %}
                                            {% for dia in dias_semana %}
                                                {% set filtros_dia_css = filtros_dia_css ~ (' js-dia-' ~ dia) %}
                                            {% endfor %}
                                        {% endif %}
                                        {% set filtros_ubicacion_css = 'js-ubicacion-' ~ sede_comision.ubicacion %}
                                        {% set filtros_css = filtros_dia_css ~ ' ' ~ filtros_ubicacion_css %}
                                   
                                    {% if sede_comision.inscripto %}

                                        <li class='comision inscripto visible'>
                                            {% include 'info_curso/comision_inscripto.twig' with {
                                            'comision':	sede_comision,
                                            'catalogo_id':	this.data.catalogo_id,
                                            'si':	this.data.si,
                                            'no':	this.data.no,
                                            'inscripcion_pendiente':	this.data.inscripcion_pendiente,
                                            'inscripcion_aceptada':	    this.data.inscripcion_aceptada,
                                            'csrf':		this.data.csrf
                                            } only %}
                                        </li>

                                    {% else %}

                                        <li class='comision no-inscripto visible {{ filtros_css }}'>
                                            {% include 'info_curso/comision_no_inscripto.twig' with {
                                            'comision':	sede_comision,
                                            'catalogo_id':	this.data.catalogo_id,
                                            'si':	this.data.si,
                                            'no':	this.data.no,
                                            'csrf':		this.data.csrf
                                            } only %}
                                        </li>

                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                            
                {% endfor %}

            </ul>

        {% endif %}

    {% elseif this.estado == this.data.estado_error_curso_seleccionado %}
        <h3>{{this.data.curso_nombre}} ({{this.data.curso_codigo}})</h3>
        {% import "kernel/macro_notificaciones.twig" as notificaciones %}
        {{ notificaciones.render_notif(this.data.mensajes) }}
        <p><i class="icon-arrow-left"></i> {{ 'inscripcion_cursos.seleccione_curso_del_listado'|trans }}</p>
    {% endif %}

    <div id="modal_modo_devolucion_pago" class="modal hide fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            <h3 id="myModalLabel">{{ 'inscripcion_cursos.seleccione_modo_devolucion_pago'|trans }}</h3>
        </div>
        <div class="modal-body">

            <input type="hidden" name="mdp_csrf" id="mdp_csrf">
            <input type="hidden" name="mdp_curso" id="mdp_curso">
            <input type="hidden" name="mdp_hash_curso" id="mdp_hash_curso">
            <input type="hidden" name="mdp_comision" id="mdp_comision">
            <input type="hidden" name="mdp_inscripcion" id="mdp_inscripcion">
            <input type="hidden" name="mdp_baja_inicial" id="mdp_baja_inicial">

            <div id="control_group_mdp_modo_devolucion_pago" class="control-group">
                <label class="control-label" for="mdp_modo_devolucion_pago">{{ 'inscripcion_cursos.modos_devolucion_pago'|trans }}:</label>
                <div class="controls">
                    <select id="mdp_modo_devolucion_pago" name="mdp_modo_devolucion_pago" class="input-xlarge">
                        <!-- Se llena con JS -->
                    </select>
                    <span class="help-inline"></span>
                </div>
            </div>

        </div>
        <div class="modal-footer">
            <button class="btn" data-dismiss="modal" aria-hidden="true">{{ 'inscripcion_cursos.cancelar'|trans|capitalize }}</button>
            <button id="mdp_dar_baja" class="btn btn-primary">{{ 'inscripcion_cursos.mensaje_confirmar_baja'|trans|capitalize }}</button>
        </div>
    </div>

{% endblock %}
