<h3>{{ 'inscripcion_cursos.comenzar_inscripcion' | trans }}</h3>
<p><i class="icon-arrow-left"></i> {{ 'inscripcion_cursos.seleccione_curso_del_listado' | trans }}</p>

{% if inscripciones %}
    <h4>{{ 'inscripciones_activas'|trans|capitalize }}</h4>
    <span class='js-csrf hide' data-csrf='{{csrf}}'/>
    <table class="table table-condensed">
        {% for inscripcion in inscripciones %}
            <tr class='js-mis-inscripciones'>
                <td>{{inscripcion.actividad_nombre}} - {{inscripcion.comision_nombre}}</td>
                <td>
                    {% for info_cupo in inscripcion.info_cupo %}
                        {#{"cupo"|trans|capitalize}}: {% if info_cupo.cupo_definido %} {{ info_cupo.cupo }} {% else %} {{"cupo_sin_definir"|trans|capitalize}}  {% endif %} | {{"inscriptos"|trans|capitalize}}: {{ info_cupo.cant_inscriptos }#}
                        {% if info_cupo.cupo_definido %}
                            <div class='row-fluid'>
                                {% set porcentaje = info_cupo.porcentaje_cupo %}
                                <div class='span5'>
                                    <b>{{ info_cupo.tipo_clase }}</b>
                                </div>
                                <div class='progress span6'>
                                    {% if porcentaje >= 90 and porcentaje < 100 %}
                                        {% set barra = 'bar-warning' %}
                                    {% elseif porcentaje >= 100 %}
                                        {% set barra = 'bar-danger' %}
                                    {% else %}
                                        {% set barra = 'bar-success' %}
                                    {% endif%}
                                    <div class='bar {{barra}}' style='width: {{ porcentaje ~ '%' }}'></div>
                                    <div class="info-progress">
                                        {{ info_cupo.cant_inscriptos ~ '/' ~ info_cupo.cupo }}
                                    </div>

                                </div>
                                <div class='span1'>
                                    {% if porcentaje >=100 %}
                                        <i title='{{'mensaje_maximo_cupo'|trans}}'class="icon-exclamation-sign"></i>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <div class='sin-progress'>
                                {{"cupo"|trans|capitalize}}: {{"cupo_sin_definir"|trans|capitalize}}
                            </div>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>

                    <div class="iconos-pago-container2">

                        {% if (inscripcion.comision_cobrable == si) and (inscripcion.estado_inscripcion == inscripcion_aceptada) %}
                            <div class="icono icono-pago-efectuado">
                                <i class="fa fa-check-circle" aria-hidden="true" title="{{ 'inscripcion_cursos.inscripcion_pago_efectuado'|trans }}"></i>
                            </div>
                        {% endif %}

                        {% if (inscripcion.comision_cobrable == si) and (inscripcion.estado_inscripcion == inscripcion_pendiente) %}
                            <div class="icono icono-pago-pendiente">
                                <i class="fa fa-exclamation-circle" aria-hidden="true" title="{{ 'inscripcion_cursos.inscripcion_pendiente_pago'|trans }}"></i>
                            </div>
                        {% endif %}

                        <div style="clear: both;"></div>
                    </div>

                </td>
            </tr>

            {% if inscripcion.error_btn_pagar %}
                <tr>
                    <td colspan="3">
                        <div class="alert alert-error" style="margin: 0;">{{ "inscripcion_cursos.error_inscripcion_pendiente_pago"|trans }}</div>
                    </td>
                </tr>
            {% endif %}

            <tr class='js-mis-inscripciones'>
                <td colspan="3">

                    <div class='comprobante-cursada' data-img='{{inscripcion.URL_COMP}}' data-msg-toggle='<i class="comprobante"></i> {{"esconder_comprobante"|trans|capitalize}} <i class="descolapsado"></i>'>
                        <a href='#'><i class="comprobante"></i> {{"mostrar_comprobante"|trans|capitalize}} <i class="colapsado"></i></a>
                        <div class='img-placeholder hide'>
                            <div class="comprobante-actions">
                                <a class='btn btn-small js-print-comprobante' data-img='{{ inscripcion.URL_IMP_COMP }}'><i class="icon-print"></i>{{'imprimir'|trans|capitalize}}</a>
                                <a class='btn btn-small js-mail-comprobante' href='{{inscripcion.URL_MAIL_COMP}}'><i class="icon-envelope"></i>{{'enviar_por_mail'|trans|capitalize}}</a>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            <tr class='js-boton-baja'>
                <td colspan="3">

                    {% if inscripcion.pago_pendiente %}
                        <button data-token-sq="{{ inscripcion.sq_token }}" data-curso="{{inscripcion.actividad}}" data-inscripcion="{{ attribute(inscripcion, catalogo_id) }}" class="btn btn-mini btn-primary js-pagar pull-right" title="{{ 'inscripcion_cursos.tooltip_boton_pagar'|trans }}"><i class="fa fa-usd" aria-hidden="true"></i> {{'pagar'|trans|capitalize }}</button>
                    {% endif %}

                    <button
                            class="js-baja-inicial btn btn-mini pull-right" type="button"
                            data-curso="{{inscripcion.actividad}}"
                            data-hash-curso="{{inscripcion.url_actividad}}"
                            data-comision="{{inscripcion.url_comision}}"
                            data-inscripcion="{{ attribute(inscripcion, catalogo_id) }}"
                            {% if not inscripcion.baja_habilitada %}
                                disabled
                                data-toggle="tooltip"
                                data-placement="top"
                                title=""
                                data-original-title="{{ 'inscripcion_cursos.tooltip_boton_baja'|trans }}"
                            {% endif %}>
                            <i class="icon-remove"></i> {{'dar_baja'|trans|capitalize}}
                    </button>

                </td>
            </tr>
        {% endfor %}
    </table>
{% endif %}