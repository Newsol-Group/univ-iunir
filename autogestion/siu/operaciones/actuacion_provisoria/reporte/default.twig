{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    <div class="titulo_operacion_">
        <h2 class="clearfix"><span class="pull-left">{% if this.data.datos.reporte_titulo | capitalize %} {{ this.data.datos.reporte_titulo | capitalize }} {% else %} {{ this.data.datos.reporte | capitalize }} {% endif %}</span>
            {% if this.data.datos.0 %}
                <div class="pull-right">
                    <a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_pdf ~ '_' ~ this.data.datos.reporte }}"><i class="g3w-icono-pdf"></i></a>
                    <a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_excel ~ '_' ~ this.data.datos.reporte }}"><i class="g3w-icono-xls"></i></a>
                </div>
            {% endif %}
        </h2>
    </div>

    {% if this.data.datos.0 %}
        {% import "kernel/macro_columnas_tabla.twig" as macro_titulos %}
        <table class="table table-striped table-bordered table-condensed">
            <thead>
                <!-- Títulos -->
                {{ macro_titulos.render_titulador(this.data.titulos, this.data.atributos_titulos, this.data.corte.campo) }}
            </thead>

            <!-- Datos -->
            {% for columnas in this.data.datos %}
                <tr>
                    {% for keyline, columna in columnas %}
                        {% if (keyline != "URL_LINEA") %}
                            <td>
                                {{columna}}
                            </td>
                        {% endif %}					
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <div class="alert">
            {{"reporte.no_hay_datos.actuacion_provisoria"|trans|capitalize}} en {% if this.data.datos.reporte_titulo %} {{ this.data.datos.reporte_titulo }} {% else %} {{ this.data.datos.reporte }} {% endif %}
        </div>
    {% endif %}
{% endblock %}