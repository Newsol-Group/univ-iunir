{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	{% if this.data.clases_no_anuladas %}
		<div class="titulo-navbar clearfix">
			<div class="subnav-combo">
				<ul class="pull-left clearfix">
					<select class="form-control span12 js-combo-clase">
						{% for clase in this.data.clases_no_anuladas %}
							<option value="{{ clase.clase }}" {% if (clase.selected) %}    selected {% endif %}
									data-link= {{ clase.url }}>{{ clase.desc }} </option>
						{% endfor %}
					</select>
				</ul>
				<div class="pull-left box-mostrar-libres">
					<input type="checkbox" value="0" name="mostrar_libres" id="mostrar_libres" class="pull-left check_box" />
					<label for="mostrar_libres" class="pull-left label_check_box">{{ 'asistencias.mostrar_libres' | trans | capitalize }}</label>
				</div>
			</div>
			<div class="pull-right subnav-btn">
				<button class="btn btn-small" id="js-colapsar-info-clase"><i class="icon-th-list"></i> <span>Detalles</span></button>
			</div>
		</div>

		<div class="js-detalle-clase" style="display: none;">
			<table class="table table-condensed">
				<tr>
					<td><strong>{{'tipo_clase'|trans|capitalize}}:</strong></td>
					<td>{{ this.data.tipo_clase }}</td>
					<td><strong>{{'horario'|trans|capitalize}}:</strong></td>
					<td>{{ this.data.dia_semana_desc }} de {{ this.data.hora_inicio_formateada }} a {{ this.data.hora_finalizacion_formateada }} </td>
					<td><strong>{{'cantidad_horas'|trans|capitalize}}:</strong></td>
					<td>{{ this.data.cantidad_horas_dictadas }}</td>
				</tr>
			</table>
		</div>
	{% endif %}
{% endblock %}