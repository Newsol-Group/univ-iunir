{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% if not this.data.elegir_orientacion %}
                
        <div class="alert">
            {{ "reporte.no_elegir.orientaciones" | trans | capitalize }}
        </div>
                
    {% else %}        
            
        {% if this.data.orientacion_guardada %}

            <div class="alert alert-success">
                {{ "orientacion.guardado_ok" | trans | capitalize }}
            </div>

        {% endif %}

        {% if this.data.orientaciones is not empty %}

            {% if this.data.tiene_orientacion_seleccionada %}

                <h3>{{ "orientacion_actual" | trans | capitalize }}</h3>

            {% else %}

                <h3>{{ "orientacion_no_elegida" | trans | capitalize }}</h3>

            {% endif %}

            <table class="table table-striped table-bordered table-condensed">
                <thead>
                <tr>
                    <th>{{ "orientacion_tit_nombre" | trans | capitalize }}</th>				
                    <th></th>
                </tr>
                </thead>

                <tbody>
                {% for orientacion in this.data.orientaciones %}
                    {# Muestro la fila en caso de ser la seleaccionada o en caso de no tener ninguna orientacion seleccionada#}
                    {% if (orientacion.seleccionada and this.data.tiene_orientacion_seleccionada) or not this.data.tiene_orientacion_seleccionada %}
                        {# Genero las etiquetas necesarias para el link de la fila en caso de no tener ninguna orientacion seleccionada #}
                        <tr {% if (orientacion.elemento) and not this.data.tiene_orientacion_seleccionada %} class="data" data-link="{{orientacion.elemento}}"{% endif %}>
                            <td class="nombre">{{ orientacion.elemento_nombre }}</td>						
                            <td class="seleccion">
                                <a class="btn btn-small btn-primary btn-selec" data-link="{{orientacion.elemento}}"
                                   type="button" data-encuesta="{{ encuesta_resultado.encuesta }}"
                                    {% if this.data.tiene_orientacion_seleccionada %} disabled {% endif %}>
                                    {{ 'orientacion.seleccione' | trans | capitalize}}
                                </a>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
                </tbody>
            </table>

            {% if not this.data.tiene_orientacion_seleccionada %}
                <form action="{{ this.data.form_url }}" id="form_orientacion" method="post">
                    <input type="hidden" id="id_orientacion" name="id_orientacion" />
                </form>
            {% endif %}

        {% else %}

                <div class="alert">
                    {{ "reporte.no_hay_datos.orientaciones" | trans | capitalize }}
                </div>            

        {% endif %}
    {% endif %}

{% endblock %}