{% extends "kernel/pagelet.twig" %}
{% block contenido %}

        {# Si no viene de Convocatorias a Becas #}
        {% if not this.viene_de_convocatorias_becas() %}
            {% import "macro_mensajes.twig" as mensajes %}
            <div id="mensajes">
                    {{ mensajes.render_mensajes(this.datos_confirmados(), this.datos_error_control(), this.datos_vigentes()) }}
            </div>
	{% endif %}
	
	{% autoescape false %}

	<div class='controls controls-row form-head clearfix'>
		<div class='borde-inferior'>
			<div class='pull-left'>
				<h2>{{this.get_nombre_seccion()|trans}}</h2>
			</div>
			<div class='clearfix'></div>
		</div>
	</div>

	{% if this.data.modo == 'listado' %}
		{#---- Pantalla listado ----#}
		{% if this.data.cant_antecedentes == 0 %}
			<div class='alert mensaje'>
				{{'datos_censales.est.sin_estudios'|trans|raw}}
			</div>
		{% else %}
			<div>
				<table class="table table-stripped table-hover">
					<thead>
						<tr>
							<th>{{'datos_censales.est.nivel_estudio_descr'|trans}}</th>
							<th>{{'datos_censales.est.institucion_colegio_descr'|trans}}</th>
							<th>{{'datos_censales.est.titulo_descr'|trans}}</th>
							<th class='eventos'>&nbsp;</th>
						</tr>
					</thead>
					<tbody>
					{% for item in this.get_datos_estudios() %}
						<tr>
							<td>{{item.nivel_estudio_descr}}</td>
							<td>{{item.institucion_colegio_descr}}</td>
							<td>{{item.titulo_descr}}</td>
							<td class='eventos'>
								<a id='editar_estudio' href="{{ item.LINK_EDITAR }}" class="btn btn-info btn-small js-btnEditar" title="{{'editar'|trans|capitalize}}"><i class="icon-white icon-pencil"></i></a>
								<a href="{{ item.LINK_ELIMINAR }}" class="btn btn-info btn-small js-btnEliminar" title="{{'eliminar'|trans|capitalize}}"><i class="icon-white icon-remove"></i></a>
							</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}

		<div class="pull-left fix-boton">
			<a href="{{ this.get_accion_edicion() }}" class="btn btn-inverse">
				 {{'datos_censales.est.agregar_estudio'|trans}} 
			</a>
		</div>
                <div class="clearfix"></div>
	{% else %}
		{#---- Pantalla alta / edición ----#}
		{% set form = this.get_form() %}
		{{ form.encabezado }}
			<div class='well clearfix'>
				<h3>{{'datos_censales.est.carga_estudio'|trans}}</h3>
				{{ form.control_group('__ID__') }}
				<div class='clearfix cg-margen'>
					{{ form.control_group('nivel_estudio') }}
				</div>
				
				<div id='div_datos_estudio'>
				
					<div id='div_institucion'>
						{{ form.control_group('institucion') }}
						<div class='clearfix cg-margen'>
							{{ form.control_group('institucion_descr', 'span9') }}
							<div class='span3'>
								<input id="btnLimpiarInst" value="{{'datos_censales.limpiar'|trans}}" type="button" class="btn btn-inverse js-boton-limpiar" />
							</div>
						</div>
						<div id='institucion_help' class='clearfix inline-help cg-margen'>
							{{'datos_censales.est.ayuda_institucion'|trans}}
						</div>
					</div>

					<div id='div_colegio'>
						{{ form.control_group('colegio') }}
						<div class='clearfix cg-margen'>
							{{ form.control_group('colegio_descr', 'span9') }}
							<div class='span3'>
								<input id="btnLimpiarColegio" value="{{'datos_censales.limpiar'|trans}}" type="button" class="btn btn-inverse js-boton-limpiar" />
							</div>
						</div>
						<div id='colegio_help' class='clearfix inline-help cg-margen'>
							{{'datos_censales.est.ayuda_colegio'|trans}}
						</div>
						<div class='clearfix cg-margen'>
							{{ form.control_group('anio_egreso') }}
						</div>
						<div class='clearfix cg-margen'>
							{{ form.checkbox('adeuda_materias_secundario') }}
						</div>
					</div>

					<div id='div_titulo'>
						{{ form.control_group('titulo') }}
						<div class='clearfix cg-margen'>
							{{ form.control_group('titulo_descr', 'span9') }}
							<div class='span3'>
								<input id="btnLimpiarTitulo" value="{{'datos_censales.limpiar'|trans}}" type="button" class="btn btn-inverse js-boton-limpiar" />
							</div>
						</div>
						<div id='titulo_help' class='clearfix inline-help cg-margen'>
							{{'datos_censales.est.ayuda_titulo'|trans}}
						</div>
					</div>
				
					<div id='div_datos_nivel_sup'>
						<div class='clearfix cg-margen'>
							{{ form.control_group('titulo_tesis') }}
						</div>
						<div class='clearfix cg-margen'>
							{{ form.control_group('director_tesis') }}
						</div>
					</div>
					
					<div id='div_otros_datos' class='clearfix'>
						{{ form.control_group('estado', 'span6') }}
						{{ form.control_group('fecha_ingreso', 'span3') }}
						<div id='div_fecha_egreso'>
							{{ form.control_group('fecha_egreso', 'span3') }}
						</div>
					</div>
						
					<div id='motivos-abandono' class='clearfix cg-margen'>
						{{ form.control_group('razon_abandono') }}
						<div id='motivo-abandono-otro'>
						{{ form.control_group('razon_abandono_otros') }}
						</div>
					</div>
				
				</div>
			</div>

			<div class='controls controls-row form-head clearfix'>
			<div class='borde-superior'>
				<div class='pull-right'>
					{{ form.submit_button('guardar_edicion', 'datos_censales.guardar')  }}
					<a href="{{ this.get_accion_volver_edicion() }}" class="btn btn-info">
						{{ 'volver'|trans|capitalize }} 
					</a>
				</div>
			</div>
		</div>
		</form>
	{% endif %}
	{% endautoescape %}
        
        {% import "macro_confirmacion.twig" as confirmacion %}
        {{ confirmacion.mostrar(this.viene_de_convocatorias_becas(), this.hay_datos_faltantes_convocatoria(), this.get_url_siguiente_paso()) }}
        
{% endblock %}