{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    <div class="titulo_operacion">
        <h2 class="clearfix">
            <span class="pull-left">
                {{"header.menu.listado_cursos" | trans }}
            </span>
        </h2>
    </div>

	{% if this.data.propuestas is empty %}

        <div id="alert-no-hay-preguntas" class="alert">{{ this.data.msg_sin_dato }}</div>

    {% else %}

		{# Creo expandible para mostrar listado de cursos #}
		{% for  propuesta  in this.data.propuestas %}
			<div class="accordion-group">
				<div class="encabezado-form clearfix  accordion-heading">
					<div class="accordion-toggle titulo" data-toggle="collapse" data-target="#collapse{{ propuesta.propuesta}}">

						<div class="estado_actual">{{ propuesta.propuesta_nombre }}</div>
						<div class="js-minimizar" ><i class="icon-chevron-down icon-white" ></i></div>
						<div style="clear: both;"></div>
					</div>
				</div>

				<div id="collapse{{ propuesta.propuesta }}" class="accordion-body collapse">
					<div class="accordion-inner">


							<table class="table table-bordered table-condensed">
							<thead>
								<tr>
									<th> {{ 'listado_cursos.anio_academico' | trans }}</th>
									<th> {{ 'listado_cursos.curso' | trans }}</th>
									<th> {{ 'listado_cursos.estado' | trans }}</th>
									<th> {{ 'listado_cursos.nota' | trans }}</th>
									<th> {{ 'listado_cursos.resultado' | trans }}</th>
									<th> {{ 'listado_cursos.fecha' | trans }}</th>
								</tr>
							</thead>

							<tbody>

									{% for dato in  propuesta.cursos %}
										<tr>
											<td> {{dato.anio_academico }} </td>
											<td> {{dato.actividad_nombre}} </td>
											<td> {{ dato.estado }} </td>
											<td> {{ dato.nota }}	
												{% if dato.nota %}
													({{ dato.nota_desc }})
												{% endif %}
											</td>
											<td> {{ dato.resultado }} </td>
											<td> {{ dato.fecha }} </td>
										</tr>
										{% endfor %}

								</tbody>
							</table>
					</div>
				</div>
			</div>

		{% endfor %}

	{% endif %}	
	
{% endblock %}