{% macro render_examenes(renglones, this) %}
    {% if renglones %}
            <div class="js-recuadro_general">
                <fieldset>

                    <div class="js-recuadro_actividad">
                        {% for actividad, mesas in renglones %}


                            <table class="table table-striped table-bordered table-condensed">
                                <thead>
                                <tr>
                                    <th colspan="6" class='header-actividad'>{{ actividad }}</th>
                                </tr>
                                <tr>
                                    <th class='header-cols'>{{ 'carga_notas_mesa_examen.mesa' |trans | capitalize }}</th>
                                    <th class='header-cols'>{{ 'carga_notas_mesa_examen.llamado' |trans | capitalize }}</th>
									<th class='header-cols'>{{ 'carga_notas_mesa_examen.fecha' |trans | capitalize }}</th>
                                    <th class='header-cols'>{{ 'carga_notas_mesa_examen.ubicacion' |trans | capitalize }}</th>
                                    <th class='header-cols'>{{ 'ficha_alumno.cant_inscriptos' |trans | capitalize }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for mesa in mesas %}
                                    <tr {{ this.data_link(mesa.link) | raw }}>
                                        <td style="width: 215px;">{{ this.a(mesa.link, mesa.mesa_examen_nombre) |raw }}</td>
                                        <td style="width: 218px;">{{ mesa.llamado_nombre }}</td>
										<td style="width: 175px;">{{ mesa.fecha_formato_visual }}</td>
                                        <td style="width: 149px;">{{ mesa.ubicacion_nombre }}</td>
                                        <td>{{ mesa.cant_inscriptos }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                        {% endfor %}
                    </div>
                </fieldset>
            </div>
    {% else %}
        <div class="alert">
            {{ 'carga_notas_mesa_examen.no_hay_mesas'|trans|capitalize }}
        </div>
    {% endif %}
{% endmacro %}