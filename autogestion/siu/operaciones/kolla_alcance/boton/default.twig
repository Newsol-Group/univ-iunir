{% extends "kernel/pagelet_polite.twig" %}
{% block contenido %}
<div class='alert alert-warning clearfix'>
	{{ 'tit_kolla_alcance'|trans|capitalize }}

	<form method='post' action='{{this.data.url_boton}}'>
		<select name="alcance">
			{% for alcance in this.data.alcance %}
				<option value="{{alcance.0}}">{{alcance.1}}</option>
			{% endfor %}
		</select>
		<input type='submit' value='{{ 'boton'|trans|capitalize }}'>
		</form>
</div>
{% endblock %}