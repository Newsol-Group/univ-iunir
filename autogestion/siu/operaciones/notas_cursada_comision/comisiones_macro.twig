{% macro render_comisiones(renglones, this) %}
	{% if renglones %}
		{% for periodo, actividades in renglones %}
			<div class="js-recuadro_periodo recuadro">
				<h3 style="color: #555;">{{ periodo }}</h3>

				<div class="js-recuadro_actividad">
					{% for actividad, comisiones in actividades %}
						<h4 style="background-color: #0088cc; color: white;">{{ actividad }}</h4>
						<table class="table table-striped table-bordered table-condensed table-striped listado-comisiones">
							<thead style="background-color: #999;">
							<tr>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_comision' |trans | capitalize }}</th>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_subcomision' |trans | capitalize }}</th>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_ubicacion' |trans | capitalize }}</th>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_responsabilidad' |trans | capitalize }}</th>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_turno' |trans | capitalize }}</th>
								<th style="text-align: center;">{{ 'notas_cursada_comision.tabla_inscripciones' |trans | capitalize }}</th>
							</tr>
							</thead>
							<tbody>
							{% for comision in comisiones %}
								<tr {{ this.data_link(comision.link) | raw }}>
									<td style="width: auto;">{{ this.a(comision.link, comision.comision_nombre) | raw }}</td>
									<td style="width: 200px;">{% if comision.subcomision_nombre %}{{ comision.subcomision_nombre }}{% if comision.tipo_clase %} ({{ comision.tipo_clase }}){% endif %}{% else %}{{ 'no_tiene' |trans|capitalize }}{% endif %}</td>
									<td style="width: 150px;">{{ comision.ubicacion_nombre }}</td>
									<td style="width: 80px;">{% if comision.responsabilidad_nombre %}{{ comision.responsabilidad_nombre }}{% else %}{{ 'no_asignado' |trans|capitalize }}{% endif %}</td>
									<td style="width: 70px;">{% if comision.turno_nombre %}{{ comision.turno_nombre }}{% else %}{{ 'sin_definir' |trans|capitalize }}{% endif %}</td>
									<td style="width: 100px;">{{ comision.cant_inscriptos }}</td>
								</tr>
							{% endfor %}
							</tbody>
						</table>
					{% endfor %}
				</div>
			</div>
		{% endfor %}
	{% else %}
		<div class="alert">{{ 'no_hay_comisiones'|trans|capitalize }}</div>
	{% endif %}
{% endmacro %}