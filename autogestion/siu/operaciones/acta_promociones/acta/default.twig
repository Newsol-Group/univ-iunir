{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    <div class="titulo_operacion">
		<h2 class="clearfix">
			<button class='btn btn-primary btn-small js-btn-back pull-left' data-url-back="{{this.data.url_back}}"><i class="icon-chevron-left icon-white"></i></button>
			<span class="pull-left">{{"actas_de_promocion"|trans|capitalize}}</span>
		</h2>
    </div>
    
	{% set encabezado = true %}
    {% for folio in this.data.alumnos %}
        {% if folio.ENCABEZADO %}
			{% if encabezado %}
				{% set encabezado = false %}
				<table class="table table-condensed">
					<tr>
						<td><strong>{{"info_materia.materia" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.MATERIA}}</td>
						<td><strong>{{"info_materia.acta" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.ACTA}}</td>
					</tr>
					<tr>
						<td><strong>{{"anio_academico" | trans | capitalize}}:</strong> </td>
						<td>{{folio.ENCABEZADO.ANIO_ACAD}}</td>
						<td><strong>{{"folio" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.FOLIO}}</td>
					</tr>
					<tr>
						<td><strong>{{"periodo_lectivo" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.PER_LEC}}</td>
						<td><strong>{{"comision" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.COMISION}}</td>
					</tr>
					<tr>
						<td><strong>{{"libro" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.LIBRO}}</td>
						<td><strong>{{"plan.estado" | trans | capitalize}}:</strong></td>
						<td>{{folio.ENCABEZADO.ESTADO_ACTA}}</td>
					</tr>
					<tr>
						<td><strong>{{"docente_comision" | trans | capitalize}}:</strong></td>
						<td colspan="3">{{folio.ENCABEZADO.DOCENTES}}</td>
					</tr>
					<tr>
						<td><strong>{{"observaciones" | trans | capitalize}}:</strong></td>
						<td colspan="3">{{folio.ENCABEZADO.OBS}}</td>
					</tr>
				</table>
			{% else %}
				<table class="table table-condensed">
					<tr>
						<td><strong>{{"folio" | trans | capitalize}}:</strong> {{folio.ENCABEZADO.FOLIO}}</td>
					</tr>
				</table>
			{% endif %}
        {% endif %}
        <table class="table table-striped table-bordered table-condensed">
	    <thead>
		<tr>
			<th>{{"renglon" | trans | capitalize}}</th>
		    <th>{{"legajo" | trans | capitalize}}</th>
		    <th>{{"apellido_y_nombre" | trans | capitalize}}</th>
		    <th>{{"fecha" | trans | capitalize}}</th>
		    <th colspan="2">{{"nota" | trans | capitalize}}</th>
		    <th>{{"resultado" | trans | capitalize}}</th>
			
		</tr>
	    </thead>
            {% for alumno in folio.CUERPO %}
            <tr>
                <td>{{alumno.RENGLON|raw}}</td>
                <td>{{alumno.LEGAJO|raw}}</td>
                <td>{{alumno.APE_NOM|raw}}</td>
                <td>{{alumno.FECHA|raw}}</td>
                <td>{{alumno.NOTA_NUM|raw}}</td>
                <td>{{alumno.NOTA_LETRAS|raw}}</td>
                <td>{{alumno.RESULTADO|raw}}</td>
            </tr>
            {% endfor %}
        </table>
    {% endfor %}
{% endblock %}