{% macro mostrar_mensajes(mensajes) %}
    
    {% if mensajes is not empty %}
        <div>
            {% for mensaje in mensajes %}
                <div class="alert {{ mensaje.tipo }}">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    {{ mensaje.mensaje | raw }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

{% endmacro %}