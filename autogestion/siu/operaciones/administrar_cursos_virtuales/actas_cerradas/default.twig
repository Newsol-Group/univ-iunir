{% extends "kernel/pagelet.twig" %}
{% block contenido %}    

    <div class="titulo_operacion">
        <h2 class="clearfix">
            <span class="pull-left">{{ "moodle.actas_cerradas.titulo" | trans }}</span>
        </h2>
    </div>

    {# Si se trata de una subcomisión #}
    {% if this.data.es_subcomision  %}
    <div class="alert alert-block" style="text-align: left !important;">
        <p>{{ "moodle.leyenda_subcomisiones" | trans | raw }}</p>
    </div>
    {% endif %}
    
    <div class="alert alert-block alert-error" style="text-align: left !important;">
        <h4>{{ "moodle.actas_cerradas.mensaje" | trans | raw }}</h4>
    </div>

{% endblock %}
