{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {# Si hubo errores al descargar la encuesta #}
    {% if this.data.error_descarga_encuesta %}
        <div class="alert alert-error">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            {{ this.data.error_descarga_encuesta | raw }}
        </div>
    {% endif %}
        
    {% if this.data.encuestas_respondidas %}

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="centrado">{{ 'encuestas_respondidas.encuesta' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_respondidas.descripcion' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_respondidas.fecha_respuesta' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_respondidas.es_anonima' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_respondidas.acciones' | trans }}</th>
                </tr>
            </thead>

            <tbody>
        {% for encuesta_respondida in this.data.encuestas_respondidas %}
            <tr>
                <td>{{ encuesta_respondida.encuesta_titulo }}</td>
                <td>{{ encuesta_respondida.formulario_titulo }}</td>
                <td class="centrado">{{ encuesta_respondida.sfecha_respuesta }}</td>
                <td class="centrado">{{ encuesta_respondida.anonima == this.data.si ? 'encuestas_respondidas.si'|trans : 'encuestas_respondidas.no'|trans }}</td>
                <td>
                    <button class="btn btn-small btn-primary ver" type="button" data-habilitacion="{{ encuesta_respondida.kolla_id_habilitacion }}" data-formulario="{{ encuesta_respondida.formulario }}" data-codigo-externo="{{ encuesta_respondida.codigo_externo }}" data-password="{{ encuesta_respondida.kolla_password }}" data-anonima="{{ encuesta_respondida.anonima == 'S' ? '1' : '0' }}">
                        <i class="icon-eye-open icon-white"></i> {{ 'encuestas_respondidas.ver' | trans }}
                    </button>
                    
                    {# Solo se pueden descargar las encuestas no anónimas #}
                    {% if encuesta_respondida.anonima == this.data.no %}
                    <a class="btn btn-small no-ajax" href="{{ encuesta_respondida.url_descargar }}">
                        <i class="icon-download"></i> {{ 'encuestas_respondidas.descargar' | trans }}
                    </a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
            </tbody>
        </table>

        <div id="codigo_recuperacion" class="modal hide fade"></div>
        <div id="encuesta_respondida_kolla" class="modal hide fade"></div>

    {% else %}

        <div class="alert">{{ 'encuestas_respondidas.no_hay_encuestas_respondidas' | trans }}</div>

    {% endif %}

{% endblock %}