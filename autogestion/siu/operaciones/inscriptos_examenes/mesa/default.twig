{% extends "kernel/pagelet.twig" %}
{% import 'kernel/macro_helpers.twig' as helper %}
{% block contenido %}
{% set acciones %}
			<a class="btn no-ajax" target="_blank" href="{{this.data.url_generar_pdf}}"><i class="g3w-icono-pdf"></i></a>
			<a class="btn no-ajax" target="_blank" href="{{this.data.url_generar_xls}}"><i class="g3w-icono-xls"></i></a>
{% endset %}
{{ helper.titulo_operacion('inscriptos_examenes'|trans|capitalize,this.data.url_back, acciones)}}
{% if this.data.mesa %}
{% set titulos = this.data.mesa %}
<table class="table table-striped table-bordered table-condensed">
	<tr><td>{{'nombre_actividad'|trans|capitalize}}: {{titulos.actividad_nombre}} ({{titulos.actividad_codigo}})</td></tr>
	<tr><td>{{'fecha'|trans|capitalize}}: {{titulos.fecha_examen}}</td></tr>
	<tr><td>{{'ubicacion'|trans|capitalize}}: {{titulos.ubicacion_nombre}}</td></tr>
	<tr><td>{{'horario'|trans|capitalize}}: {{titulos.hora_inicio_finalizacion}}</td></tr>
	<tr><td>{{'docentes'|trans|capitalize}}: {{titulos.docentes}}</td></tr>
	<tr><td>{{'instancias'|trans|capitalize}}: {{titulos.instancias}}</td></tr>
	<tr><td>{{'turno'|trans|capitalize}}: {{titulos.turno_examen_nombre}}</td></tr>
	<tr><td>{{'llamado'|trans|capitalize}}: {{titulos.llamado_nombre}}</td></tr>
</table>
{% endif %}
{% if this.data.alumnos %}
<table class="table table-striped table-bordered table-condensed">
	<thead>
		<tr>
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.legajo' |trans }}</td>
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.alumno' |trans }}</td>
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.instancia' |trans }}</td>
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.estado' |trans }}</td>
                        {# Si el docente puede visualizar los datos de contacto de los alumnos (email y teléfono) #}
                        {% if this.data.visualiza_datos_contacto %}
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.email' |trans }}</td>
			<td class="cc-titulo-nivel-0">{{'inscriptos_examenes.telefono' |trans }}</td>
                        {% endif %}
			<td class="cc-titulo-nivel-0"></td>
		</tr>
	</thead>
	<tbody>
	{% for alumno in this.data.alumnos %}
		<tr>
			<td>{{alumno.legajo}}</td>
			<td>{{alumno.nombre_alumno}}</td>
			<td>{{alumno.instancia_nombre}}</td>
			<td>{{alumno.estado_inscripcion}}</td>
                        {# Si el docente puede visualizar los datos de contacto de los alumnos (email y teléfono) #}
                        {% if this.data.visualiza_datos_contacto %}
			<td>{{alumno.email}}</td>
			<td>{{alumno.telefono}}</td>
                        {% endif %}
			<td> 
                            <span class="btn btn-mini js-ficha_alumno" data-url-ficha="{{ alumno.URL }}">{{'ver cursada' | trans | capitalize}}</span>
                        </td>
		</tr>
	{% endfor %}
	</tbody>
</table>
{% else %}
	<div class="alert">{{'inscriptos_examenes.detalle.vacio'|trans|capitalize}}</div>
{% endif %}
{% endblock %}