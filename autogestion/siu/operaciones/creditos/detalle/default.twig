{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    <div class="titulo_operacion">
        <h2 class="clearfix">
			<span class="pull-left">{{"creditos detalle"|trans|capitalize}}</span>
            <button class='btn js-btn-back pull-right' data-url-back="{{this.data.url_back}}">{{'volver'|trans|capitalize}}</button>
        </h2>
    </div>
	{% if this.data.datos %}
	<table class="table table-striped table-bordered table-condensed">
		<tr>
			<th>{{"carrera" | trans | capitalize}}</th>
			<th>{{"creditos_en_mano" | trans | capitalize}}</th>
			<th>{{"creditos.creditos_en_insc_curs" | trans | capitalize}}</th>
		</tr>
		{% for valor in this.data.datos %}
		<tr>
			<td>
				{{valor.carrera}}
			</td>
			<td>
				{{valor.cred_mano}}
			</td>
			<td>
				{{valor.cred_cur}}
			</td>
		</tr>
		{% endfor %}
	</table>
	{% else %}
		<div class="alert">
			{{"reporte.no_hay_datos.creditos"|trans|capitalize}}
		</div>
	{% endif %}
{% endblock %}