{% extends "kernel/pagelet.twig" %}
{% import 'kernel/macro_helpers.twig' as helper %}
{% import _self as current_file_macros %}

{% block contenido %}
    {% set form = this.get_vista_form() %}
    {% set acciones %}
        {{ form.render_acciones() | raw }}
    {% endset %}
    {{ form.render_encabezado() | raw }}
    {{ helper.titulo_operacion('zona.zona_clases_tit'|trans|capitalize,'', acciones) }}
    <div class='row'>
        <div class='span10 offset1'>
            {{ form.render_cuerpo() | raw }}
        </div>
    </div>
    {{ form.render_cierre() | raw }}

	<div id="comisiones">
		{{ current_file_macros.render_comisiones(this.data.renglones, this) }}
	</div>
{% endblock %}

{% macro render_comisiones(renglones, this) %}
    {% if renglones %}
        {% for periodo, actividades in renglones %}
            <div class="js-recuadro_periodo">
                <fieldset>
                    <legend>{{ periodo }}</legend>
                    <div class="js-recuadro_actividad">
                        {% for actividad, comisiones in actividades %}
                            <table class="table table-striped table-bordered table-condensed">
                                <thead>
									<tr>
										<th colspan="6" class='header-actividad'>{{ actividad }}</th>
									</tr>
									<tr>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_comision' |trans | capitalize }}</th>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_subcomision' |trans | capitalize }}</th>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_ubicacion' |trans | capitalize }}</th>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_responsabilidad' |trans | capitalize }}</th>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_turno' |trans | capitalize }}</th>
										<th class='header-cols'>{{ 'notas_cursada_comision.tabla_inscripciones' |trans | capitalize }}</th>
									</tr>
                                </thead>
                                <tbody>
									{% for comision in comisiones %}
									{% if comision.link %}
										{#---- Fila linkeable: param asistencia_registrar_asistencia = 'S' -------#}
										<tr {{ this.data_link(comision.link) | raw }}>
									{% else %}
										{#---- Fila NO linkeable: param asistencia_registrar_asistencia = 'N' ----#}
										<tr>
									{% endif %}
											<td style="width: auto;">
											{% if comision.link %}
												{{ this.a(comision.link, comision.comision_nombre) |raw }}</td>
											{% else %}
												<span title="{{ 'zona_clases.comision_no_asistencia' | trans }}" class="cursor-help">{{ comision.comision_nombre }}</span></td>
											{% endif %}
											<td style="width: 200px;">{% if comision.subcomision_nombre %}{{ comision.subcomision_nombre }}{% if comision.tipo_clase %} ({{ comision.tipo_clase }}){% endif %}{% else %}{{ 'no_tiene' |trans|capitalize }}{% endif %}</td>
											<td style="width: 150px;">{{ comision.ubicacion_nombre }}</td>
											<td style="width: 80px;">{% if comision.resp_docente %}{{ comision.resp_docente }}{% else %}{{ 'no_asignado' |trans|capitalize }}{% endif %}</td>
											<td style="width: 70px;">{% if comision.turno_nombre %}{{ comision.turno_nombre }}{% else %}{{ 'sin_definir' |trans|capitalize }}{% endif %}</td>
											<td style="width: 100px;">{{ comision.cant_inscriptos }}</td>
										</tr>
									{% endfor %}
                                </tbody>
                            </table>
                        {% endfor %}
                    </div>
                </fieldset>
            </div>
        {% endfor %}
    {% else %}
        <div class="alert">{{ 'no_hay_comisiones'|trans|capitalize }}</div>
    {% endif %}
{% endmacro %}