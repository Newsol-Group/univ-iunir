	</parameter>
	<parameter name="verificacion_codigo" class="java.lang.String"/>
	<parameter name="verificacion_url" class="java.lang.String"/>
	<parameter name="verificacion_qr" class="java.lang.String"/>
	<parameter name="apellido_y_nombre" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
                    $P!{apellido_y_nombre} as apellido_y_nombre,
                    vw_personas.tipo_nro_documento as documento_principal,
                    sga_propuestas.nombre as propuesta_nombre,
                    '(' || sga_propuestas.codigo || ') ' || sga_propuestas.nombre as propuesta_nombre_completo,
                    sga_propuestas.nombre_abreviado as propuesta_nombre_abreviado,
                    sga_ubicaciones.nombre as ubicacion_nombre,
                    sga_constancias_solicitud.presentar_a,
                    COALESCE(sga_constancias_solicitud.observaciones, ' ') AS observaciones,
                    mug_localidades.nombre as ciudad,
                    mug_provincias.nombre as provincia,
                    sga_instituciones.nombre as nombre_institucion,
                    to_char(vw_mesas_examen.mesa_examen_fecha, 'DD/MM/YYYY') AS fecha_examen,
                    vw_mesas_examen.mesa_examen_elemento_nombre AS actividad,
					f_responsables_academicas_propuesta(sga_alumnos.propuesta) AS ra_nombre
                FROM sga_constancias_solicitud
                JOIN sga_alumnos  ON sga_constancias_solicitud.alumno = sga_alumnos.alumno
                JOIN vw_personas  ON sga_alumnos.persona = vw_personas.persona
                JOIN mdp_personas ON vw_personas.persona = mdp_personas.persona
                JOIN sga_propuestas ON sga_propuestas.propuesta = sga_alumnos.propuesta
                JOIN sga_instituciones  ON sga_instituciones.institucion = get_ra_inst_araucano_propuesta(sga_alumnos.propuesta, 'IG')
                JOIN vw_mesas_examen ON vw_mesas_examen.llamado_mesa = $P{llamado_mesa}
                JOIN sga_ubicaciones ON sga_ubicaciones.ubicacion = vw_mesas_examen.mesa_examen_ubicacion
                JOIN mug_localidades ON mug_localidades.localidad = sga_ubicaciones.localidad
                JOIN mug_dptos_partidos ON mug_dptos_partidos.dpto_partido = mug_localidades.dpto_partido
                JOIN mug_provincias  ON mug_provincias.provincia = mug_dptos_partidos.provincia
                WHERE sga_constancias_solicitud.solicitud = $P{solicitud}]]>
	</queryString>
