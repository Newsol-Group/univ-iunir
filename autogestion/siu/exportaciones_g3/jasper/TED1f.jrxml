	</field>
	<field name="ra_nombre" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="ciudad" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="plan_nombre" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
