	<detail>
		<band height="544" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="440" height="56" uuid="666fde87-f088-4f21-9c06-9ba686f7c6cd"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["						VISTO: El T.E.D. Nº: " + $F{nro_expediente} + " iniciado por " + $F{apellido_y_nombre}.toUpperCase() + ", " + $F{documento_principal} + ", quien ha finalizado los estudios de la carrera de " + $F{propuesta_nombre}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Comun" x="0" y="433" width="440" height="43" uuid="d9aceb94-a9f2-486e-880f-c36d70f64c78"/>
				<textElement textAlignment="Justified">
					<font size="12" isItalic="false"/>
				</textElement>
				<text><![CDATA[ARTICULO 3º: ELEVAR, las actuaciones correspondientes a Secretaría General Académica.]]></text>
			</staticText>
			<staticText>
				<reportElement style="Comun" x="0" y="476" width="440" height="31" uuid="d5646e3a-6b69-4289-99a0-b46972dab366"/>
				<textElement textAlignment="Justified">
					<font size="12" isItalic="false"/>
				</textElement>
				<text><![CDATA[ARTICULO 4º: REGISTRAR, COMUNICAR, NOTIFICAR.  Cumplido.
ARCHIVAR.-]]></text>
			</staticText>
			<textField>
				<reportElement style="Resalt" x="0" y="521" width="396" height="17" uuid="11b44d57-f66a-4f78-8e27-2f27aab6528b"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["DISPOSICION Nº: " + $F{nro_disposicion_decano}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="77" width="440" height="96" uuid="4f5df69a-64b5-4df7-bc4d-1057ff34e1ad"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["						CONSIDERANDO:\n" +
"						QUE: la persona ha cumplido con todos los requisitos exigidos por el Plan de Estudios " + $F{plan_nombre} + " de la Carrera de " + $F{propuesta_nombre} + " de la facultad de " + $F{ra_nombre} + " de esta Universidad, de acuerdo a lo establecido por Res. Nº " + $F{nro_resolucion} + ", de el/la " + $F{nombre_institucion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="270" width="440" height="69" uuid="78620e0a-de21-43d7-ac96-a3d3d4f2ded2"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["ARTICULO 1º: CERTIFICAR, que " + $F{apellido_y_nombre}.toUpperCase() + " - " + $F{documento_principal} + ".- ha finalizado sus estudios en la Carrera de " + $F{propuesta_nombre} + ", haciendose acreedor al título de " + $F{certificado_nombre} + ".-"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="349" width="440" height="69" uuid="eb56b70e-f0cd-4e7b-b40a-35ca46eace1c"/>
				<textElement textAlignment="Justified">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["ARTICULO 2º: SOLICITAR, a Rectorado, se expida el diploma de " + $F{certificado_nombre} + " en la Carrera de " + $F{propuesta_nombre} + ", Plan de Estudios " + $F{plan_nombre} + ", de acuerdo a la Res. Nº " + $F{nro_resolucion} + " de el/la " + $F{nombre_institucion} + "."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Comun" x="0" y="184" width="440" height="19" uuid="5406eebf-9cc8-4820-adcc-31758184ab39"/>
				<textElement textAlignment="Center">
					<font size="12" isItalic="false"/>
				</textElement>
				<text><![CDATA[POR ELLO:]]></text>
			</staticText>
			<staticText>
				<reportElement style="Comun" x="0" y="245" width="440" height="19" uuid="e726fd41-385f-4a03-bdbb-6fe6add25561"/>
				<textElement textAlignment="Center">
					<font size="12" isItalic="false"/>
				</textElement>
				<text><![CDATA[DISPONE:]]></text>
			</staticText>
			<textField>
