	<title>
		<band height="95" splitType="Stretch">
			<staticText>
				<reportElement style="Title" x="0" y="0" width="440" height="27" uuid="c72c7ff7-b55b-4ae4-a249-886c4478ce08"/>
				<textElement textAlignment="Center">
					<font isUnderline="true"/>
				</textElement>
				<text><![CDATA[FORMULARIO T.E.D. 1.f.-]]></text>
			</staticText>
			<textField>
				<reportElement style="Comun" x="172" y="49" width="268" height="15" uuid="f7130b9d-f701-4429-9b8c-7cd18496888f"/>
				<textElement textAlignment="Right">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["T.E.D. Nº: " + $F{nro_expediente}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" x="55" y="66" width="385" height="19" uuid="1dcdac1c-204b-4d9b-bad3-dab9e7858f58"/>
				<textElement textAlignment="Right">
					<font size="12"/>
				</textElement>
