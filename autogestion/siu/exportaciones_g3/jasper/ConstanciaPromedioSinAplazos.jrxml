				</reportElement>
			</line>
			<textField>
				<reportElement x="13" y="166" width="446" height="47" uuid="3b3fcd5f-8e40-4789-b933-4b7954ab7b56"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Se extiende la presente constancia para ser presentada ante " + $F{presentar_a}.toUpperCase() + " en " + $F{ciudad} + ", " + $F{provincia} + " a los " + $V{fecha_narrada} +"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Resalt" x="2" y="15" width="125" height="18" uuid="699154f1-9ef0-4ca1-8d7c-e6d7f955e04e"/>
