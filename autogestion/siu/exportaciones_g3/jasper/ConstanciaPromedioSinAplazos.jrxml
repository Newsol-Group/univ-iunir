	</columnHeader>
	<detail>
		<band height="450" splitType="Stretch">
			<textField>
				<reportElement x="13" y="129" width="447" height="30" uuid="04c36112-59c6-4fb5-b563-d5d5a4aa1df5"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Por la presente, se deja constancia que la persona cuyos datos se citan anteriormente tiene un Promedio Académico de: " + $F{promedio} + " (aplazos no incluídos)"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="288" y="323" width="130" height="1" uuid="bdc88fb8-71fe-496d-b8a3-d18dac010ec3">
