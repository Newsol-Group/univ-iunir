			</textField>
			<textField>
				<reportElement style="Comun" x="130" y="103" width="348" height="18" uuid="8196b312-4816-4479-bb75-8027a84d7921"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{propuesta_nombre_completo}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="225" y="324" width="264" height="20" uuid="e4b598e3-b3a2-4a45-9fce-202e7d0f5ede">
