<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="guarani" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="NoDataSection" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3b7cc6f5-36a8-48bd-aa8d-b0f2b6468bf8">
	<property name="ireport.zoom" value="1.4641000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="288"/>
	<style name="Title" fontName="Times New Roman" fontSize="14" isBold="true" isUnderline="true" pdfFontName="Times-Bold"/>
	<parameter name="solicitud" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer(1)]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="autoridad_cargo" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="autoridad_nombre" class="java.lang.String">
		<defaultValueExpression><![CDATA["Firma"]]></defaultValueExpression>
	</parameter>
	<parameter name="clase" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="ocultar_firma" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
	</parameter>
	<parameter name="verificacion_qr" class="java.lang.String"/>
	<parameter name="verificacion_url" class="java.lang.String"/>
	<parameter name="verificacion_codigo" class="java.lang.String"/>
	<parameter name="apellido_y_nombre" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
   $P!{apellido_y_nombre} as apellido_nombres,
    vw_personas.tipo_nro_documento,
    vw_comisiones.comision_nombre,
    vw_comisiones.elemento_nombre,
    to_char(sga_clases.fecha, 'DD/MM/YYYY') as fecha,
    to_char(sga_asignaciones.hora_inicio, 'HH24:mi') as hora_inicio,
    to_char(sga_asignaciones.hora_finalizacion, 'HH24:mi') as hora_finalizacion,
    sga_asignaciones.dia_semana,
    sga_propuestas.nombre propuesta_nombre,
    sga_ubicaciones.nombre ubicacion_nombre,
    sga_constancias_solicitud.presentar_a,
    to_char(CURRENT_DATE, 'DD/MM/YYYY') as hoy,
    sga_instituciones.nombre as nombre_institucion,
    f_responsables_academicas_propuesta(sga_alumnos.propuesta) AS ra_nombre
    FROM   sga_constancias_solicitud
    JOIN sga_alumnos ON sga_constancias_solicitud.alumno = sga_alumnos.alumno
    JOIN vw_personas ON sga_alumnos.persona = vw_personas.persona
    JOIN sga_propuestas ON sga_propuestas.propuesta = sga_alumnos.propuesta
    JOIN sga_clases ON sga_clases.clase = $P{clase}
    JOIN sga_comisiones_bh ON sga_comisiones_bh.banda_horaria = sga_clases.banda_horaria
    JOIN vw_comisiones ON vw_comisiones.comision = sga_comisiones_bh.comision
    JOIN sga_ubicaciones ON sga_ubicaciones.ubicacion = vw_comisiones.ubicacion
    JOIN sga_asignaciones ON sga_asignaciones.asignacion = sga_comisiones_bh.asignacion
    JOIN sga_instituciones ON sga_instituciones.institucion = get_ra_inst_araucano_propuesta(sga_alumnos.propuesta, 'IG')
    JOIN mdp_personas ON vw_personas.persona = mdp_personas.persona
    WHERE sga_constancias_solicitud.solicitud = $P{solicitud}
    LIMIT 1]]>
	</queryString>
	<field name="apellido_nombres" class="java.lang.String"/>
	<field name="tipo_nro_documento" class="java.lang.String"/>
	<field name="comision_nombre" class="java.lang.String"/>
	<field name="elemento_nombre" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="hora_inicio" class="java.lang.String"/>
	<field name="hora_finalizacion" class="java.lang.String"/>
	<field name="dia_semana" class="java.lang.String"/>
	<field name="propuesta_nombre" class="java.lang.String"/>
	<field name="ubicacion_nombre" class="java.lang.String"/>
	<field name="presentar_a" class="java.lang.String"/>
	<field name="hoy" class="java.lang.String"/>
	<field name="nombre_institucion" class="java.lang.String"/>
	<field name="ra_nombre" class="java.lang.String"/>
	<variable name="fecha_narrada" class="java.lang.String">
		<variableExpression><![CDATA[new java.text.SimpleDateFormat("dd 'días del mes de' MMMM 'de' yyyy", new java.util.Locale("es")).format(new java.util.Date())]]></variableExpression>
	</variable>
	<background>
		<band height="802" splitType="Stretch">
