				<reportElement x="28" y="87" width="497" height="57" uuid="110e42b1-be74-4784-bc38-cee791b591ea"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{ra_nombre}]]></textFieldExpression>
			</textField>
			<image>
				<reportElement x="28" y="7" width="92" height="40" uuid="1b01060c-52a0-4dfa-a218-21ed569447bf"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="28" y="56" width="497" height="20" uuid="6eaa24f8-0f3d-46db-8431-31a2cf5826c8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nombre_institucion}.toUpperCase()]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band height="48" splitType="Stretch">
			<staticText>
				<reportElement style="Title" x="28" y="12" width="497" height="23" uuid="ee936c70-4673-4302-b64f-af7d7fead711"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Constancia de Asistencia a Clase]]></text>
			</staticText>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="366" splitType="Stretch">
			<staticText>
				<reportElement x="131" y="251" width="29" height="20" uuid="87c75f57-6fcc-4e6f-98dc-cfae9a55c04b">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
				</reportElement>
				<text><![CDATA[Sello]]></text>
			</staticText>
			<line>
				<reportElement x="330" y="250" width="130" height="1" uuid="f8b38d59-8c6e-464a-be45-68347b7297a0">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
				</reportElement>
			</line>
			<line>
				<reportElement x="83" y="250" width="130" height="1" uuid="e3e8256a-112d-4af9-bd3b-6c86288bd45b">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
				</reportElement>
			</line>
			<textField isBlankWhenNull="true">
				<reportElement x="264" y="251" width="261" height="20" uuid="b5811651-8d92-48a8-b842-ec2224484307">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{autoridad_nombre}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="264" y="271" width="261" height="20" uuid="a4589143-fb55-4d0b-9d67-591e08735960">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{autoridad_cargo}]]></textFieldExpression>
			</textField>
			<image>
				<reportElement x="228" y="199" width="92" height="92" uuid="549f584d-95a3-43aa-b94c-3f5ea9c4ec4b">
					<printWhenExpression><![CDATA[!($P{verificacion_qr}.trim()).isEmpty()]]></printWhenExpression>
				</reportElement>
				<imageExpression><![CDATA[$P{verificacion_qr}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="98" y="318" width="417" height="48" uuid="4fff9b89-02ac-4499-904f-c03d3009b683">
					<printWhenExpression><![CDATA[!($P{verificacion_qr}.trim()).isEmpty()]]></printWhenExpression>
				</reportElement>
				<textFieldExpression><![CDATA["Esta constancia podrá ser validada ingresando a " + $P{verificacion_url}+ " completando el código de validación y el Nº de DNI (o pasaporte), o bien escaneando el código QR."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="298" width="300" height="20" uuid="e14ef2ad-a69e-45ce-a62d-8c2ae9e7e7b4">
					<printWhenExpression><![CDATA[!($P{verificacion_qr}.trim()).isEmpty()]]></printWhenExpression>
				</reportElement>
				<textFieldExpression><![CDATA["CÓDIGO DE VALIDACIÓN: " + $P{verificacion_codigo}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="56" y="14" width="447" height="91" uuid="e5544662-612f-433e-8124-a75fba1e92ef"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Por medio de la presente se deja constancia de que " + $F{apellido_nombres} + ", " + $F{tipo_nro_documento}  + ", asistió a la clase de " + $F{elemento_nombre} + " el día " + $F{fecha} + " de " + $F{hora_inicio} + " a " + $F{hora_finalizacion} + " Materia de la carrera de " + $F{propuesta_nombre} + " que se cursa en " + $F{ubicacion_nombre} +
".\nSe extiende la presente constancia para ser presentada ante " + $F{presentar_a} + ", a los " + $V{fecha_narrada} + "."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
