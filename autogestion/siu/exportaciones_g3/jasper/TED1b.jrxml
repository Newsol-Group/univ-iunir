	<summary>
		<band height="57" splitType="Stretch">
			<textField>
				<reportElement style="Comun" x="30" y="3" width="430" height="16" uuid="31bcefed-49f7-42b4-8cd6-5c74a4fe2964"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{nombre_institucion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" x="30" y="20" width="430" height="36" uuid="39afd854-c59e-49f0-a24a-fe751ef66a9a"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{ra_nombre}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
