	<parameter name="nro_solicitud" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT	
						COALESCE(sga_certificados_otorg.nro_expediente, ' - ') AS nro_expediente,
						f_responsables_academicas_propuesta(sga_propuestas.propuesta) as nombre_ra,
						sga_instituciones.nombre as nombre_institucion,
						CASE vw_personas.sexo
        					WHEN 'F' THEN sga_certificados.nombre_femenino
							WHEN 'X' THEN sga_certificados.nombre_no_binario
        					ELSE sga_certificados.nombre 
   				 		END AS certificado_nombre,
						to_char(sga_certificados_otorg.fecha_egreso, 'DD/MM/YYYY') AS fecha_egreso_alumno,
						COALESCE(sga_certificados_otorg.resolucion_rectorado, '') AS resolucion_rectorado,
						COALESCE(sga_certificados_otorg.nro_registro_diploma_uni, '') AS registro_diploma_universidad,
						COALESCE(sga_alumnos.legajo, '') AS alumno_legajo,
						vw_personas.apellido as alumno_apellido,
						vw_personas.nombres as alumno_nombre,
						vw_personas.desc_tipo_documento || ' ' || vw_personas.nro_documento as documento_principal,
						to_char(mdp_personas.fecha_nacimiento,'DD/MM/YYYY') as alumno_fecha_nacimiento,
						mdp_personas_sexo.descripcion as alumno_sexo,
						mdp_datos_personales.estado_civil,
						COALESCE(mdp_estados_civiles.descripcion, '') AS estado_civil_descr,
						COALESCE(mdp_datos_personales.periodo_lectivo_calle, '') || COALESCE(mdp_datos_personales.periodo_lectivo_numero, '') || COALESCE(mdp_datos_personales.periodo_lectivo_piso, '') || COALESCE(mdp_datos_personales.periodo_lectivo_departamento, '') AS direccion_alumno_residencia,
						mdp_datos_personales.periodo_lectivo_localidad,
						COALESCE(mdp_datos_personales.procedencia_calle, '') || COALESCE(mdp_datos_personales.procedencia_numero, '') || COALESCE(mdp_datos_personales.procedencia_piso, '') || COALESCE(mdp_datos_personales.procedencia_departamento) AS direccion_alumno_procedencia,
						mdp_datos_personales.procedencia_localidad,
						COALESCE(localidad_periodo.nombre, '')	AS localidad_periodo_nombre,
						COALESCE(provincia_periodo.nombre, '')	AS provincia_periodo_nombre,
						COALESCE(pais_periodo.nombre, '')	AS pais_periodo_nombre,
						COALESCE(localidad_procedencia.nombre, '')	AS localidad_procedencia_nombre,
						COALESCE(provincia_procedencia.nombre, '')	AS provincia_procedencia_nombre,
						COALESCE(pais_procedencia.nombre, '')		AS pais_procedencia_nombre,
						COALESCE(mdp_personas_allegados.apellido, '') || ' ' || COALESCE(mdp_personas_allegados.nombres, '') as conyugue_nombre,
						COALESCE((SELECT '(' || telefono_codigo_area || ') ' || telefono_numero
                      			    FROM mdp_personas_contactos
						           WHERE persona = mdp_personas.persona
                      			     AND contacto_tipo IN ('C','T','L','F')
                      			ORDER BY  contacto_tipo = 'C' DESC, contacto_tipo = 'T' DESC, contacto_tipo = 'L' DESC, contacto_tipo = 'F' DESC  LIMIT 1),' ') AS telefono
					FROM sga_certificados_otorg
					JOIN sga_planes_versiones ON sga_certificados_otorg.plan_version = sga_planes_versiones.plan_version
					JOIN sga_planes ON sga_planes_versiones.plan = sga_planes.plan
					JOIN sga_propuestas ON sga_planes.propuesta = sga_propuestas.propuesta
					JOIN sga_responsables_academicas ON TRUE
					JOIN sga_instituciones ON sga_instituciones.institucion = sga_responsables_academicas.institucion
					JOIN sga_certificados ON sga_certificados_otorg.certificado = sga_certificados.certificado
					JOIN sga_alumnos ON sga_certificados_otorg.alumno = sga_alumnos.alumno
					JOIN vw_personas ON sga_alumnos.persona = vw_personas.persona
					JOIN mdp_personas ON mdp_personas.persona = vw_personas.persona
                    JOIN mdp_personas_sexo ON mdp_personas_sexo.sexo = mdp_personas.sexo
					LEFT JOIN mdp_datos_personales ON mdp_datos_personales.dato_censal = get_ultimo_dato_censal(mdp_personas.persona)
					LEFT JOIN mdp_datos_censales ON mdp_datos_censales.dato_censal = get_ultimo_dato_censal(mdp_personas.persona)
					LEFT JOIN mdp_personas_allegados ON mdp_personas_allegados.dato_censal = mdp_datos_censales.dato_censal AND mdp_personas_allegados.tipo_allegado = 'C'
					LEFT JOIN mug_localidades as localidad_periodo ON localidad_periodo.localidad = mdp_datos_personales.periodo_lectivo_localidad
					LEFT JOIN mug_dptos_partidos as partido_periodo ON localidad_periodo.dpto_partido = partido_periodo.dpto_partido
					LEFT JOIN mug_provincias provincia_periodo ON partido_periodo.provincia = provincia_periodo.provincia
					LEFT JOIN mug_paises pais_periodo ON provincia_periodo.pais = pais_periodo.pais
					LEFT JOIN mug_localidades as localidad_procedencia ON localidad_procedencia.localidad = mdp_datos_personales.procedencia_localidad
					LEFT JOIN mug_dptos_partidos as partido_procedencia ON localidad_procedencia.dpto_partido = partido_procedencia.dpto_partido
					LEFT JOIN mug_provincias provincia_procedencia ON partido_procedencia.provincia = provincia_procedencia.provincia
					LEFT JOIN mug_paises pais_procedencia ON provincia_procedencia.pais = pais_procedencia.pais
					LEFT JOIN mdp_estados_civiles ON mdp_datos_personales.estado_civil = mdp_estados_civiles.estado_civil
					
					WHERE sga_certificados_otorg.nro_solicitud = $P{nro_solicitud}
					  AND sga_responsables_academicas.responsable_academica = get_ra_inst_araucano_propuesta(sga_planes.propuesta, 'RA')]]>
	</queryString>
