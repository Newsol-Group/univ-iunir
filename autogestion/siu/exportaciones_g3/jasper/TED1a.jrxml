	</field>
	<field name="nro_expediente" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nombre_ra" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
