	<field name="resolucion_plan_nro" class="java.lang.String"/>
	<field name="resolucion_plan_fecha" class="java.lang.String"/>
	<field name="nro_resolucion_ministerial" class="java.lang.String"/>
	<field name="nro_resolucion_coneau" class="java.lang.String"/>
	<field name="titulo_anterior" class="java.lang.String"/>
	<field name="institucion_anterior" class="java.lang.String"/>
	<field name="institucion_extranjera" class="java.lang.Boolean"/>
	<background>
