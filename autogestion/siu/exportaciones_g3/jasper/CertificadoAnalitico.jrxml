	</background>
	<title>
		<band height="189" splitType="Stretch">
			<textField>
				<reportElement style="Comun" x="10" y="90" width="488" height="95" uuid="a724e2e3-9082-4225-aba3-1571064f16dd"/>
				<textElement textAlignment="Justified">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["La " + $F{nombre_institucion} +  " certifica que "
+ $F{apellido_y_nombre}
+ ($F{legajo}.equals(" -- ") ? "" : ", Legajo Nº " + $F{legajo})
+ ", " + $F{documento_principal}
+ ", quien ingresó con el Título de " + $F{titulo_anterior} + " de la " + $F{institucion_anterior}
+ ", ha cursado y aprobado las asignaturas correspondientes al Plan de Estudios de la carrera de " + $F{propuesta_nombre}
+ ($F{nro_resolucion_ministerial}.equals(" -- ") ? "" : ", Resolución Ministerial Nº " + $F{nro_resolucion_ministerial})
+ ($F{nro_resolucion_coneau}.equals(" -- ") ? "" : ", Resolución CONEAU Nº " + $F{nro_resolucion_coneau})
+ ", obteniendo las siguientes calificaciones que abajo se expresan: "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="SubTitle" x="118" y="65" width="275" height="16" uuid="385ecd1c-d3cf-4553-8c77-35cca342a011"/>
				<textElement textAlignment="Center">
					<font isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA["CERTIFICADO ANALÍTICO DE MATERIAS"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Comun" x="0" y="0" width="404" height="14" uuid="c5beca85-68c3-41b6-81b1-401e257ea97e"/>
				<textFieldExpression><![CDATA[$F{nombre_institucion}.toUpperCase()]]></textFieldExpression>
			</textField>
