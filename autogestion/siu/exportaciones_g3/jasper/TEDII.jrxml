		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="ubicacion_nombre" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="ciudad" class="java.lang.String">
