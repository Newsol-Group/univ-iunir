{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    {% autoescape false %}
        <div id='js-div_mensaje' class="mensaje alert alert-warning strong"></div>
        {% if this.data.cant_preinscripciones == 0 %}
            <div class='alert alert-info mensaje strong'>
                {{'preinscripcion.sin_preinscripciones'|trans|raw}}
            </div>
        {% else %}
            <div>
                <h2 class="borde-inferior">{{ 'preinscripcion.propuestas_elegidas' | trans }}
                    <div class="pull-right" >
                    </div>
                </h2>
                    
            {% if this.data.error %}
                <div class='alert alert-error'>
                    {{ this.data.error }}
                </div>
            {% endif %}
            {% if this.data.mensaje %}
                <div class='alert '>
                    {{ this.data.mensaje }}
                </div>
            {% endif %}
                <table class="table table-stripped table-hover">
                    <thead>
                        <tr>
                            <th>{{'preinscripcion.responsable_academica'|trans}}</th>
                            <th>{{'preinscripcion.propuesta_bis'|trans}}</th>
                            <th>{{'preinscripcion.ubicacion'|trans}}</th>
                            <th>{{'preinscripcion.modalidad'|trans}}</th>
                            <th>{{'preinscripcion.vigente_hasta'|trans}}</th>
                            <th>{{'preinscripcion.fecha_pago'|trans}}</th>
                            <th>{{'preinscripcion.estado_pago'|trans}}</th>
                            {# <th>{{'preinscripcion.link_mp'|trans}}</th> #}
                            <th>{{'preinscripcion.link_mcp'|trans}}</th>
                            <th>&nbsp;</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in this.data.preinscripciones %}
                            {% set matricula = this.data.matriculas[item.preinscripcion] %}
                            {% set p_disabled = (matricula.estado_pago == 3) %}
                            {# {% set f_disabled = (not p_disabled and item.propuesta != 21 and item.propuesta != 22 and item.propuesta != 23 and item.propuesta != 24) %} #}
                            {% set propuestas_sin_arancel = this.data.propuestas_sin_arancel_inscripcion %}
                            {% set f_disabled = (not p_disabled and item.propuesta not in propuestas_sin_arancel) %}
                            {# {% set f_disabled = (not p_disabled and item.propuesta_nombre_abreviado != 'DOC. CS. BIOM�DICAS') %} #}
                            {% set e_disabled = p_disabled %}
                            <tr>
                                <td>{{item.responsable_academica_nombre}}</td>
                                <td>{{item.propuesta_nombre_abreviado}}</td>
                                <td>{{item.ubicacion_nombre}}</td>
                                <td>{{item.modalidad_nombre}}</td>
                                <td>{{item.fecha_vencimiento_formato_visual}}</td>
                                <td>{{matricula.fecha_pago }}</td>
                                <td>{{matricula.estado_pago_desc}}</td>

                                {# <td>
                                {% if matricula.link != '' %}
                                    <button class="btn btn-info btn-small btnPagarMP" 
                                            {% if p_disabled %}disabled{% endif %} 
                                            data-id="{{ item.preinscripcion }}"
                                            data-link="{{ matricula.link }}"
                                            data-prop_nombre="{{item.propuesta_nombre|escape('html')}}">
                                            Pagar
                                    </button>
                                {% endif %}
                                </td> #}

                                <td>
                                {# {% if matricula.link != '' %} #}
                                    <form id="payForm_{{ item.preinscripcion }}" method="post" action="{{ this.data.mcp_data.endpoint }}" target="_blank" style="margin:0; padding:0; border:0;">
                                        <input type="hidden" name="CallbackSuccess" value="{{ this.data.mcp_data.callback_success }}" />
                                        <input type="hidden" name="CallbackCancel" value="{{ this.data.mcp_data.callback_error }}" />
                                        <input type="hidden" name="Comercio" value="{{ this.data.mcp_data.comercio }}" />
                                        <input type="hidden" name="SucursalComercio" value="{{ this.data.mcp_data.sucursal }}" />
                                        <input type="hidden" name="TransaccionComercioId" value="" />
                                        <input type="hidden" name="Monto" value="{{ matricula.monto }}" />
                                        <input type="hidden" name="Hash" value="{{ matricula.hash }}" />
                                        <input type="hidden" name="Producto[0]" value="{{ matricula.codpro }}" />
                                        <input type="hidden" name="MontoProducto[0]" value="{{ matricula.saldo }}" />
                                        <input type="hidden" name="Informacion" value="{{ matricula.ref_data }}" />
                                    </form>
                                    <button
                                        id="btn-pagar-{{ item.preinscripcion }}"
                                        {% if p_disabled %}disabled{% endif %}
                                        class="btn btn-info btn-small btnPagarMCP"
                                        data-id="{{ item.preinscripcion }}"
                                        data-codfor="{{ matricula.codfor }}"
                                        data-nrofor="{{ matricula.nrofor }}"
                                        data-prop_nombre="{{ item.propuesta_nombre|escape('html') }}">
                                        Pagar
                                    </button>
                                {# {% endif %} #}
                                </td>

                                <td>
                                {% if item.estado == 'P' or item.estado == 'S' %}
                                    <button class="btn btn-info btn-small btnReabrir" value="{{'Reabrir'|trans}}"
                                                data-id="{{item.ID}}"
                                                data-propuesta_nombre="{{item.propuesta_nombre|escape('html')}}">
                                            {{'Reabrir'|trans}}
                                    </button>
                                    <a href={{ this.data.url_pdf }} tabindex="0" id="pdf_btn" class="btn no-ajax" target="_blank" title="{{ 'descargar_pdf'|trans|capitalize }}"><span class="g3w-icono-pdf"></span></a>                    
                                {% endif %}

                                {% if item.estado =='N' %}
                                    <button class="btn btn-info btn-small btnFinalizar" value="{{'finalizar'|trans}}"
                                            {% if f_disabled %}disabled{% endif %}
                                            data-id="{{item.ID}}"
                                            data-preinsc="{{item.preinscripcion}}"
                                            data-propuesta_nombre="{{item.propuesta_nombre|escape('html')}}">
                                            {{'Finalizar'|trans}}
                                    </button>
                                {% endif %}

                                {% if item.vigente %}
                                    <button id="btn-eliminar-{{ item.preinscripcion }}" class="btn btn-info btn-small btnEliminar" value="{{'eliminar'|trans}}"
                                            {% if e_disabled %}disabled{% endif %}
                                            data-id="{{item.__ID__}}"
                                            data-propuesta_nombre="{{item.propuesta_nombre|escape('html')}}">
                                            {{'eliminar'|trans}}
                                    </button>
                                {% endif %}
                                </td>

                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        {% if this.data.permitir_inscripciones %}
            <div class="clearfix">
                <div class="pull-left fix-boton">
                    <input id="btnSelectorCarrera" name="btnSelectorCarrera" value="{{ 'preinscripcion.elegir_propuesta' | trans }}" type="button" class="btn btn-inverse" />
                </div>
            </div>
        {% endif %}
        <hr/>
    {% endautoescape %}
{% endblock %}