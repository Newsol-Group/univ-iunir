{% extends "kernel/pagelet.twig" %}
{% block contenido %}    	
{% import "kernel/macro_notificaciones.twig" as notificaciones %}

    <div class="titulo_operacion">
        <h2 class="clearfix">
            <span class="pull-left">{{ "datos_ctacte.titulo" | trans }}</span>
        </h2>
    </div>
    {% if this.data.propuestas_cursos|length > 1 or (this.data.propuestas_cursos is not empty and this.data.propuesta is empty) %}
        <form method="get" action="{{ this.data.url_consultar }}" class="form-inline">
            <label for="ctacte_propuesta">{{ "datos_ctacte.propuesta" | trans }}</label>
            <select id="ctacte_propuesta" name="propuesta" required>
                <option value="" disabled {% if this.data.propuesta is empty %}selected{% endif %}>{{ "datos_ctacte.seleccionar_propuesta" | trans }}</option>
                {% for propuesta in this.data.propuestas_cursos %}
                    <option value="{{ propuesta.propuesta }}" {% if this.data.propuesta == propuesta.propuesta %}selected{% endif %}>{{ propuesta.propuesta_nombre }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn">{{ "datos_ctacte.consultar" | trans }}</button>
        </form>
    {% endif %}
    {% if this.data.mensaje_contexto %}
        <div class="alert alert-block">{{ this.data.mensaje_contexto }}</div>
    {% elseif this.data.ctactes is empty %}
        <div class="alert alert-block">
            <h4>{{ "datos_ctacte.listado.vacio" | trans }}</h4>
        </div>
    {% else %}
        {% if this.data.resultado.mensajes %}
            {{ notificaciones.render_notif(this.data.resultado.mensajes, true) }}
            <div style="margin-top: 10px;"></div>
        {% endif %}
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="text-center">{{ "datos_ctacte.vtrmvc_codapl" | trans }}</th>
                    <th class="text-center">{{ "datos_ctacte.grcfor_descrp" | trans }}</th>
	                <th class="text-center">{{ "datos_ctacte.vtrmvc_fchvnc" | trans }}</th>
                    <th class="text-center">{{ "datos_ctacte.saldo" | trans }}</th>
                    {# <th class="text-center">{{ "datos_ctacte.ultimo_movimiento" | trans }}</th>
                    <th class="text-center">{{ "datos_ctacte.estado_pago" | trans }}</th> #}
                    <th class="text-center">{{ "datos_ctacte.link_mp" | trans }}</th>
		            <th class="text-center">{{ "datos_ctacte.link_mcp" | trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for ctacte in this.data.ctactes %}   
                {% set p_disabled = (ctacte.estado_pago == 3) %}
                {% set p_estado = ctacte.estado_pago_desc %}
                
                {% if ctacte.link == '' %}
                    {% set p_disabled = false %}
                    {% set p_estado = 'No disponible' %}
                {% endif %}
                
                {# {% if ctacte.vtrmvc_codapl != 'SID' %} #}
                    <tr>
                        <td class="text-center">{{ ctacte.vtrmvc_codapl }} - Nro.{{ ctacte.vtrmvc_nroapl }}</td>
                        <td class="text-center">{{ ctacte.grcfor_descrp }}</td>
			            <td class="text-center">{{ ctacte.vtrmvc_fchvnc }}</td>
                        <td class="text-center">{{ ctacte.saldo }}</td>

                        {# <td class="text-center">{{ ctacte.fecha_pago }}</td> #}
                        
                        {# <td {% if ctacte.link == '' %}
                                class="text-center"
                            {% else %}
                                {% if not p_disabled %}
                                    class="pago_err text-center"
                                {% else %}
                                    class="pago_ok text-center"
                                {% endif %}
                            {% endif %}>
                            {{ p_estado }}
                        </td> #}
                        
                        <td class="text-center">
                        {% if ctacte.link != '' %}
                            <button class="btn btn-primary btnPagarMP" 
                                {# target="_blank" #}
                                {# rel="noopener noreferrer"  #}
                                {% if p_disabled %}disabled{% endif %} 
                                data-comprobante="{{ ctacte.id_pago }}"
                                data-codfor="{{ ctacte.vtrmvc_codapl }}"
                                data-nrofor="{{ ctacte.vtrmvc_nroapl }}">
                                Pagar
                            </button>
                        {% endif %}
                        </td>
                        
                        <td class="text-center">
                        {% if ctacte.link != '' %}
                            <form style="margin:0; padding:0; border:0;" id="payForm_{{ ctacte.index }}" method="post" action="{{ this.data.mcp_data.endpoint }}" target="_blank">
                                <input type="hidden" name="CallbackSuccess" value="{{ this.data.mcp_data.callback_success }}"/>
                                <input type="hidden" name="CallbackCancel" value="{{ this.data.mcp_data.callback_error }}"/>
                                <input type="hidden" name="Comercio" value="{{ this.data.mcp_data.comercio }}"/>
                                <input type="hidden" name="SucursalComercio" value="{{ this.data.mcp_data.sucursal }}"/>
                                <input type="hidden" name="TransaccionComercioId" />
                                <input type="hidden" name="Monto" />
                                <input type="hidden" name="Hash" />
                                <input type="hidden" name="Producto[0]" value="{{ ctacte.grcfor_descrp }}"/>
                                <input type="hidden" name="MontoProducto[0]" value="{{ ctacte.saldo }}"/>
                                <input type="hidden" name="Informacion" value="{{ ctacte.ref_data }}" />
                            </form>
                            <button class="btn btn-primary btnPagarMCP" 
                                rel="noopener noreferrer" 
                                {% if p_disabled %}disabled{% endif %}
                                data-index="{{ ctacte.index }}"
                                data-comprobante="{{ ctacte.id_pago }}"
                                data-saldo="{{ ctacte.saldo }}">
                                Pagar
                            </button>
                        {% endif %} 
                        </td>
                    </tr>
                {# {% endif %} #}
                {% endfor %}
            </tbody>
        </table>

   	    {% if this.data.mostrar_mensaje %}
            <div class="alert {{ this.data.tipo_mensaje }}">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ this.data.mensaje }}
            </div>
        {% endif %}
        
    {% endif %}
{% endblock %}

