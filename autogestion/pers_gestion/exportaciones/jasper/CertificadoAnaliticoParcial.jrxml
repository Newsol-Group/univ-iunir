				<textElement textAlignment="Justified">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Se hace constar que las calificaciones del presente certificado de estudio coinciden con las que obran en el archivo de este instituto. \nOBSERVACIONES: " + (($F{tiene_sanciones} == 0)? "No se" : "Se" ) + " registran antecedentes negativos en su Legajo Personal.\n\nA solicitud del/de la interesado/a para ser presentado ante quien corresponda, expido el presente Certificado que firmo y sello en " + $F{ciudad} + " a los " + $V{fecha_narrada} + "."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
