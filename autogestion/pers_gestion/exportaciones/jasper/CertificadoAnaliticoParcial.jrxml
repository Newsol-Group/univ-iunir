				<textFieldExpression><![CDATA[":REPROBADO \n:INSUFICIENTE \n:APROBADO \n:BUENO \n:MUY BUENO \n:DISTINGUIDO \n:SOBRESALIENTE"]]></textFieldExpression>
			</textField>
			<textField>
