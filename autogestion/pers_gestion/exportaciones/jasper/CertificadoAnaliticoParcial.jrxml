	<subDataset name="actividades_alumno" uuid="10556f2d-6266-4ec1-a81e-c7dada5873b8">
		<parameter name="alumno" class="java.lang.Integer" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT orden_ha, orden_codigo, COALESCE(p.actividad_codigo || ' - ', '') || COALESCE(ep.nombre, p.actividad_nombre) as actividad_descr,
p.actividad_codigo,
                            p.fecha,
                            p.nota || ' (' || p.nota_descripcion || ')' as nota_completa,
                            p.origen as origen,
                            CASE
                              WHEN p.tipo = 'Aprob. por Resolución' THEN 'Resolución'
                              ELSE p.tipo
                            END as tipo,
                            p.actividad_documento,
                            p.folio_fisico as folio_fisico,
		        p.nro_libro
                    FROM negocio_nsg.f_certificado_actividades($P{alumno},'A','T','A', false, true, false) as p
					JOIN sga_alumnos ON sga_alumnos.alumno = $P{alumno}
					JOIN sga_elementos_revision as er ON er.elemento = p.elemento
					LEFT JOIN sga_elementos_plan as ep ON (ep.elemento_revision = er.elemento_revision AND ep.plan_version = sga_alumnos.plan_version)
					WHERE p.alumno_origen = $P{alumno}

union all
SELECT orden_ha, orden_codigo, COALESCE(p.actividad_codigo || ' - ', '') || COALESCE(ep.nombre, p.actividad_nombre) as actividad_descr,
p.actividad_codigo,
                            p.fecha,
                            p.nota || ' (' || p.nota_descripcion || ')' as nota_completa,
                            p.origen as origen,
                            CASE
                              WHEN p.tipo = 'Aprob. por Resolución' THEN 'Resolución'
                              ELSE p.tipo
                            END as tipo,
                            p.actividad_documento,
                            p.folio_fisico as folio_fisico,
		        p.nro_libro
                    FROM negocio_nsg.f_certificado_actividades($P{alumno},'R','T','A', false, true, false) as p
					JOIN sga_alumnos ON sga_alumnos.alumno = $P{alumno}
					JOIN sga_elementos_revision as er ON er.elemento = p.elemento
					LEFT JOIN sga_elementos_plan as ep ON (ep.elemento_revision = er.elemento_revision AND ep.plan_version = sga_alumnos.plan_version)
					WHERE p.alumno_origen = $P{alumno}
					AND p.plan_codigo = (select codigo from sga_planes where codigo = 'M-2024')
					AND sga_alumnos.plan_version = (select version_actual from sga_planes where codigo = 'M-2024')
and p.tipo <> 'Equivalencia'
union all
SELECT orden_ha, orden_codigo, COALESCE(p.actividad_codigo || ' - ', '') || COALESCE(ep.nombre, p.actividad_nombre) as actividad_descr,
p.actividad_codigo,
                            p.fecha,
                            p.nota || ' (' || p.nota_descripcion || ')' as nota_completa,
                            p.origen as origen,
                            CASE
                              WHEN p.tipo = 'Aprob. por Resolución' THEN 'Resolución'
                              ELSE p.tipo
                            END as tipo,
                            p.actividad_documento,
                            p.folio_fisico as folio_fisico,
		        p.nro_libro
                    FROM negocio_nsg.f_certificado_actividades($P{alumno},'R','T','A', false, true, false) as p
					JOIN sga_alumnos ON sga_alumnos.alumno = $P{alumno}
					JOIN sga_elementos_revision as er ON er.elemento = p.elemento
					LEFT JOIN sga_elementos_plan as ep ON (ep.elemento_revision = er.elemento_revision AND ep.plan_version = sga_alumnos.plan_version)
					WHERE p.alumno_origen = $P{alumno}
					AND sga_alumnos.plan_version <> (select version_actual from sga_planes where codigo = 'M-2024')
and p.tipo  <> 'Equivalencia'
order by orden_ha, orden_codigo]]>
		</queryString>
		<field name="orden_ha" class="java.lang.Integer"/>
		<field name="orden_codigo" class="java.lang.String"/>
		<field name="actividad_descr" class="java.lang.String"/>
		<field name="actividad_codigo" class="java.lang.String"/>
		<field name="fecha" class="java.lang.String"/>
		<field name="nota_completa" class="java.lang.String"/>
		<field name="origen" class="java.lang.String"/>
		<field name="tipo" class="java.lang.String"/>
		<field name="actividad_documento" class="java.lang.String"/>
		<field name="folio_fisico" class="java.lang.Integer"/>
		<field name="nro_libro" class="java.lang.String"/>
	</subDataset>
	<subDataset name="actividades_reprobadas_medicina" uuid="77d8f797-ecb7-4294-a6dc-567e87512196">
		<parameter name="alumno" class="java.lang.Integer" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT
						p.actividad_codigo || ' - ' || p.actividad_nombre as act_descr,
						p.actividad_codigo as act_codigo,
						p.fecha as fecha_rep,
						p.nota || ' (' || p.nota_descripcion || ' - ' || p.resultado_descripcion || ')' as nota_rep,
						p.tipo as tipo_rep,
						p.actividad_documento as act_documento_rep,
						p.resultado_descripcion as resultado_rep,
						p.folio_fisico as folio_fisico_rep,
						p.nro_libro as nro_libro_rep

					FROM negocio_nsg.f_certificado_analitico_actividades($P{alumno},'R','T','T', true, true, false) as p
					WHERE p.plan_codigo <> 'M-2024' AND p.plan_codigo like 'M-%'
					AND p.tipo <> 'Equivalencia'
ORDER BY actividad_codigo]]>
		</queryString>
		<field name="act_descr" class="java.lang.String"/>
		<field name="act_codigo" class="java.lang.String"/>
		<field name="fecha_rep" class="java.lang.String"/>
		<field name="nota_rep" class="java.lang.String"/>
		<field name="tipo_rep" class="java.lang.String"/>
		<field name="act_documento_rep" class="java.lang.String"/>
		<field name="resultado_rep" class="java.lang.String"/>
		<field name="folio_fisico_rep" class="java.lang.Integer"/>
		<field name="nro_libro_rep" class="java.lang.String"/>
	</subDataset>
	<parameter name="solicitud" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="logo" class="java.lang.String"/>
	<parameter name="autoridad_cargo" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="autoridad_nombre" class="java.lang.String">
		<defaultValueExpression><![CDATA["Firma"]]></defaultValueExpression>
	</parameter>
	<parameter name="verificacion_qr" class="java.lang.String"/>
	<parameter name="verificacion_url" class="java.lang.String"/>
	<parameter name="verificacion_codigo" class="java.lang.String"/>
	<parameter name="apellido_y_nombre" class="java.lang.String"/>
	<parameter name="ocultar_firma" class="java.lang.Boolean">
		<defaultValueExpression><![CDATA[false]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
					sga_alumnos.alumno,
vw_personas.sexo,
					COALESCE(sga_alumnos.legajo, ' -- ') AS legajo,
					vw_personas.apellido_nombres as apellido_y_nombre,
                                        vw_personas.desc_tipo_documento || ' ' || vw_personas.nro_documento as documento_principal,
					vw_planes.propuesta_nombre as propuesta_nombre,
					'(' || vw_planes.propuesta_codigo || ') ' || vw_planes.propuesta_nombre as propuesta_nombre_completo,
					vw_planes.propuesta_nombre_abreviado as propuesta_nombre_abreviado,
					vw_planes.plan_nombre as plan_nombre,
					vw_planes.version_nombre as plan_version_nombre,
					sga_constancias_solicitud.presentar_a,
					COALESCE(sga_constancias_solicitud.observaciones, ' ') AS observaciones,
					initcap(vw_localidades.localidad_nombre) as ciudad,
					vw_localidades.provincia_nombre as provincia,
					sga_instituciones.nombre as nombre_institucion,
					f_responsables_academicas_propuesta(sga_alumnos.propuesta) AS ra_nombre,
					(select max(ep.anio_de_cursada) from vw_hist_academica ic, sga_elementos_plan ep
					 where ic.alumno = sga_alumnos.alumno and ic.plan_version = ep.plan_version and ep.elemento_revision = ic.elemento_revision ) as ultimo_anio,
					(select count(*) from sga_sanciones where persona = sga_alumnos.persona and propuesta = sga_alumnos.propuesta) as tiene_sanciones,					round(f_promedio_gral_con_aplazos(sga_alumnos.alumno, date(now())),2) as promedio_con_aplazos,
					round(f_promedio_gral_sin_aplazos(sga_alumnos.alumno, date(now())),2) as promedio_sin_aplazos,
										(SELECT count(*) as cant_rep_equiv
					FROM negocio_nsg.f_certificado_analitico_actividades(sga_alumnos.alumno,'R','T','T', true, true, false) as p
					WHERE p.plan_codigo <> 'M-2024' AND p.plan_codigo like 'M-%' and not exists (select * from sga_alumnos_hist_planes a, sga_planes_versiones b, sga_planes c
																								 where a.alumno = sga_alumnos.alumno and a.plan_version = b.plan_version
																								 and c.plan = b.plan and c.codigo = p.plan_codigo )
					AND p.tipo <> 'Equivalencia')
 as cant_rep_equiv

				FROM sga_constancias_solicitud
				JOIN sga_alumnos ON sga_constancias_solicitud.alumno = sga_alumnos.alumno
				JOIN vw_personas ON sga_alumnos.persona = vw_personas.persona
                                JOIN mdp_personas ON vw_personas.persona = mdp_personas.persona
				JOIN vw_planes ON vw_planes.plan_version = sga_alumnos.plan_version
				JOIN sga_responsables_academicas ON true
				JOIN sga_instituciones ON sga_instituciones.institucion = get_ra_inst_araucano_propuesta(sga_alumnos.propuesta, 'IG')
				JOIN vw_localidades ON sga_instituciones.localidad = vw_localidades.localidad

				WHERE sga_constancias_solicitud.solicitud = $P{solicitud}
				LIMIT 1]]>
	</queryString>
	<field name="alumno" class="java.lang.Integer"/>
	<field name="sexo" class="java.lang.String"/>
	<field name="legajo" class="java.lang.String"/>
	<field name="apellido_y_nombre" class="java.lang.String"/>
	<field name="documento_principal" class="java.lang.String"/>
	<field name="propuesta_nombre" class="java.lang.String"/>
	<field name="propuesta_nombre_completo" class="java.lang.String"/>
	<field name="propuesta_nombre_abreviado" class="java.lang.String"/>
	<field name="plan_nombre" class="java.lang.String"/>
	<field name="plan_version_nombre" class="java.lang.String"/>
	<field name="presentar_a" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="ciudad" class="java.lang.String"/>
	<field name="provincia" class="java.lang.String"/>
	<field name="nombre_institucion" class="java.lang.String"/>
	<field name="ra_nombre" class="java.lang.String"/>
	<field name="ultimo_anio" class="java.lang.Integer"/>
	<field name="tiene_sanciones" class="java.lang.Long"/>
	<field name="promedio_con_aplazos" class="java.math.BigDecimal"/>
	<field name="promedio_sin_aplazos" class="java.math.BigDecimal"/>
	<field name="cant_rep_equiv" class="java.lang.Long"/>
	<variable name="fecha_narrada" class="java.lang.String">
		<variableExpression><![CDATA[new java.text.SimpleDateFormat("dd 'días del mes de' MMMM 'de' yyyy", new java.util.Locale("es")).format(new java.util.Date())]]></variableExpression>
	</variable>
