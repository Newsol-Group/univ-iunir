				<textElement textAlignment="Justified">
					<font isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["0 (cero) \n1 (uno),2 (dos),3 (tres),4 (cuatro),5 (cinco) \n6 (seis) \n7 (siete) \n8 (ocho) \n9 (nueve) \n10 (diez)"]]></textFieldExpression>
