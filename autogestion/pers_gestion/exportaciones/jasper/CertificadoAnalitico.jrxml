				<textElement textAlignment="Justified" markup="styled">
					<font isBold="false" isPdfEmbedded="false"/>
				</textElement>
				<textFieldExpression><![CDATA["El " + $F{nombre_institucion} + " certifica que <style isBold='true'>" + $F{apellido_y_nombre} + "</style>, nacid" + ($F{sexo} == 'F' ? "a" :"o") + " en " + $F{nacionalidad} + ", con <style isBold='true'>"+ $F{documento_principal} + ", "+ "Legajo Nro. " + $F{legajo} + "</style>, fecha de ingreso " + $F{fecha_ingreso} + " con título de " + $F{titulo_anterior} + " expedido por " + $F{institucion_anterior} +"; año de egreso " + $F{anio_egreso_ant} + ($F{propuesta_tipo} == 205 ? ", aprobó las asignaturas del Plan de Estudios vigente del " + $F{propuesta_nombre} + ", haciéndose acreedor" + ($F{sexo} == 'F' ? "a" :"") + " del certificado <style isBold='true'>" + $F{propuesta_nombre} + "</style> el " :" ha cursado y aprobado las asignaturas correspondientes al Plan de Estudios vigente de la carrera de <style isBold='true'>" + $F{propuesta_nombre} + "</style>, Resolución Ministerial N°" + $F{nro_resolucion_ministerial} + ($F{nro_resolucion_coneau}== " -- " ? "" : ", acreditada por CONEAU N°" + $F{nro_resolucion_coneau} ) + ", obteniendo así el título de <style isBold='true'>" + $F{certificado_nombre} + "</style> con fecha de egreso ") + $F{fecha_egreso_alumno} + "."]]></textFieldExpression>
			</textField>
		</band>
