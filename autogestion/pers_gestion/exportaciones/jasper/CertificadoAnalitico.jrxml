				<textFieldExpression><![CDATA[$F{promedio_con_aplazos}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" stretchType="RelativeToBandHeight" x="0" y="21" width="488" height="31" uuid="764cc539-94ce-4679-a298-2bb0de750674"/>
				<textElement textAlignment="Justified">
					<font isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Escala de calificaciones para exámenes vigentes desde el 29 de agosto de 2008 (Res. Rectoral 17/08)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" stretchType="RelativeToBandHeight" x="1" y="52" width="235" height="124" uuid="f33c0b65-2374-459e-aae7-d8a289d80a00"/>
				<textElement textAlignment="Justified">
					<font isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["0 (cero) \n1 (uno),2 (dos),3 (tres),4 (cuatro),5 (cinco) \n6 (seis) \n7 (siete) \n8 (ocho) \n9 (nueve) \n10 (diez)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" stretchType="RelativeToBandHeight" x="236" y="52" width="252" height="124" uuid="f87039f7-98eb-423e-80d8-d4b83e546c6c"/>
				<textElement textAlignment="Justified">
					<font isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA[":REPROBADO \n:INSUFICIENTE \n:APROBADO \n:BUENO \n:MUY BUENO \n:DISTINGUIDO \n:SOBRESALIENTE"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement style="Comun" x="1" y="193" width="488" height="139" uuid="8de718b3-926f-41b3-b3eb-b39d8a3b72ac"/>
				<textElement textAlignment="Justified">
					<font isBold="false"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["Se certifica que las calificaciones del presente certificado de estudio están de acuerdo con las que obran en el archivo de este Instituto. \n\nOBSERVACIONES: " + (($F{tiene_sanciones} == 0)? "No se" : "Se" ) + " registran antecedentes negativos en su Legajo Personal.\n\nA solicitud del/de la interesado/a para ser presentado ante quien corresponda, se expide el presente Certificado con firma y sello en " +  $F{ciudad} + ", " + $F{provincia} + ", Argentina" +  $F{fecha_actual_narrada} + "."]]></textFieldExpression>
			</textField>
		</band>
