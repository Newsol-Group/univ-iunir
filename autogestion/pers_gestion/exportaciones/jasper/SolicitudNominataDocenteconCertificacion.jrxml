			<staticText>
				<reportElement style="Title" x="29" y="0" width="497" height="36" uuid="e8ba9675-2d51-44f9-9881-1d7d9c7d381c"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[SOLICITUD DE NOMINATA DOCENTE CON CERTIFICACIÓN]]></text>
