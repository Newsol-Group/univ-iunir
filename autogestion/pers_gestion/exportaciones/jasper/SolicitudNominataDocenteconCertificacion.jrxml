			<line>
				<reportElement x="288" y="322" width="130" height="1" uuid="619c622d-0a43-4c04-9e96-3bed476fc531">
					<printWhenExpression><![CDATA[($P{ocultar_firma}.booleanValue() == false)]]></printWhenExpression>
