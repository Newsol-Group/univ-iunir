				<textElement textAlignment="Right">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Propuesta:]]></text>
			</staticText>
			<textField>
				<reportElement style="Comun" x="122" y="15" width="348" height="18" uuid="ccc07682-6a56-4fce-8b3e-95bcb655795c"/>
				<textElement>
					<font isBold="false"/>
