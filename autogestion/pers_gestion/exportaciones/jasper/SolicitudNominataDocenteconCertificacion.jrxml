			<textField>
				<reportElement x="13" y="131" width="457" height="62" uuid="0f878600-a052-482b-a1ea-2c8442ae761c"/>
				<textElement textAlignment="Justified"/>
				<textFieldExpression><![CDATA["Por la presente se certifica que el alumno cuyos datos se citan anteriormente ha solicitado la nominata docente con certificación, según se detalla a continuación: " + $F{observaciones_alu}]]></textFieldExpression>
			</textField>
			<staticText>
