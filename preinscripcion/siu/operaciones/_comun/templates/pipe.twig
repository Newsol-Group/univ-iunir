<!DOCTYPE html>
<html lang='es-419'>
    <head>
	{%if url_recursos %}
	    {%set url_recursos = url_recursos ~ '/' %}
	{% else %}
		{%set url_recursos = alias ~ '/' %}
	{%endif%}
			
	<link rel="icon" href="{{url_favicon}}" />

	{% include 'res.twig' %}
    </head>
    
    <body>
        {% include template_header %}

        <div id='loading'></div>
        <div id='loading_top' style='display:none;'>{{'cargando'|trans}}...</div>
		<div id='_msg_placeholder' style='display:none;'></div>
		<div id='kernel_contenido' class="container">
			{% if vista.get_tipo == 'VistaPagelets' %}
			{{ vista.render_skeleton }}
			{{ vista.render_pipe }}
			{% else %} {# si no es vista pagelets se renderiza directamente #}
			{{ vista.render }}
			{% endif %}
		</div>
        
        {% include template_footer %}
    </body>
</html>