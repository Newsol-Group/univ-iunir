{% if js_vars %}
	<script type='text/javascript'>
	{% for name, value in js_vars %}
		var {{name}} = '{{value}}';
	{% endfor %}
	</script>
{% endif %}

<div class='titulo_operacion row-fluid'>
    <div class="span12">
		<h1 class="borde-inferior">{{'perfil_datos.titulo'|trans}}</h1>
    </div>
</div>

<div id='layout_dos_columnas' class="row-fluid">
    <div id='columna_1' class="span7">
		{{ form.render }}
	</div>
    <div id='columna_2' class="span5">
		{{ resultado.render }}
	</div>
</div>
