{% extends "kernel/dos_columnas.twig" %}
{% block titulo_operacion %}
<h2>{{"crear_usuario"|trans}}</h2>

{% if this.hay_error() %}
<div class="alert alert-error strong">
	 <button type="button" class="close" data-dismiss="alert">&times;</button>
	{{ this.get_error()|trans|raw }}
</div>
{% endif %}
{% endblock %}
{% block columna_1 %}
	{{ contenido_alta.render }}
{% endblock %}
{% block columna_2 %}
	{{ form.render }}
{% endblock %}