{% if js_vars %}
	<script type='text/javascript'>
	{% for name, value in js_vars %}
		var {{name}} = '{{value}}';
	{% endfor %}
	</script>
{% endif %}

<div class='titulo_operacion row-fluid'>
    <div class="span12">
	<h2>{{"asoc_se.nombre_operacion"|trans}}</h2>
    </div>
</div>

<div id='layout_dos_columnas' class="row-fluid">
    <div id='columna_1' class="span5">{{ contenido.render }}</div>
    <div id='columna_2' class="span7">{{ form.render }}</div>
</div>