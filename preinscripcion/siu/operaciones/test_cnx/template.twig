{% if js_vars %}
	<script type='text/javascript'>
		{% for name, value in js_vars %}
		var  {{name}} = '{{value}}';
		{% endfor %}
	</script>
{% endif %}

<div class='titulo_operacion row-fluid'>
    <div class="span12">
		<h2>{{"test_cnx.titulo"|trans}}</h2>
    </div>
</div>

<div id='layout_dos_columnas' class="row-fluid">
    <div id='columna_1' class="span4">
		{{ configuracion.render }}
	</div>
    <div id='columna_2' class="span8">
		{{ test.render }}
	</div>
</div>